---
interface Props {
  title: string;
  deck: string;
  breadcrumbLabel: string;
  liveUrl?: string;
  githubUrl: string;
}

const { title, deck, breadcrumbLabel, liveUrl, githubUrl } = Astro.props;
---

<header class="project-hero project-hero--narrow">
  <div class="project-hero__gradient">
    <div class="project-hero__header">
      <nav class="project-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Nathan Payne</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/projects/">Projects</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current" aria-current="page">{breadcrumbLabel}</span>
      </nav>
      <h1 class="project-title">{title}</h1>
      <p class="project-deck">{deck}</p>
      <div class="project-actions">
        {liveUrl && (
          <a class="project-action" href={liveUrl} target="_blank" rel="noopener noreferrer">View Live Product</a>
        )}
        <a class="project-action" href={githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </div>
  </div>
  <hr class="project-hero__rule" />
</header>
