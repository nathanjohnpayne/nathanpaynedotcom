---
interface Props {
  title: string;
  kicker: string;
  deck: string;
  breadcrumbLabel: string;
  screenshotSrc: string;
  liveUrl: string;
  githubUrl: string;
}

const { title, kicker, deck, breadcrumbLabel, screenshotSrc, liveUrl, githubUrl } = Astro.props;
---

<header class="project-hero project-hero--narrow">
  <div class="project-hero__gradient">
    <div class="project-hero__header">
      <nav class="project-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Nathan Payne</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/projects/">Projects</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{breadcrumbLabel}</span>
      </nav>
      <p class="project-kicker">{kicker}</p>
      <h1 class="project-title">{title}</h1>
      <p class="project-deck">{deck}</p>
      <div class="project-actions">
        <a class="project-action" href={liveUrl} target="_blank" rel="noopener">View Live Product</a>
        <a class="project-action" href={githubUrl} target="_blank" rel="noopener">View on GitHub</a>
      </div>
    </div>
  </div>
  <hr class="project-hero__rule" />
</header>
