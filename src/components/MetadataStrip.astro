---
interface Props {
  topics: string;
  format: string;
  focus: string;
  status: string;
}

const { topics, format, focus, status } = Astro.props;
---

<dl class="metadata-strip metadata-strip--grid-4">
  <div class="metadata-strip__item">
    <dt>Topics</dt>
    <dd>{topics}</dd>
  </div>
  <div class="metadata-strip__item">
    <dt>Format</dt>
    <dd>{format}</dd>
  </div>
  <div class="metadata-strip__item">
    <dt>Focus</dt>
    <dd>{focus}</dd>
  </div>
  <div class="metadata-strip__item">
    <dt>Status</dt>
    <dd>{status}</dd>
  </div>
</dl>
