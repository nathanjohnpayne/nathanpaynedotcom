---
/**
 * Shared site footer (#434).
 *
 * One implementation of the attribution + nav-action footer used across the
 * blog index, projects index, blog post, project detail, and resume. The
 * cosmetic content (layout, attribution, nav, hover affordance) lives in
 * `.site-footer` in global.css so a change lands on every page at once.
 * Per-page placement/chrome is a thin `variant` modifier:
 *   - grid   → white band row in the Mondrian index grids
 *   - canvas → white footer cell inside the framed blog/resume canvas
 *   - detail → plain block in the single-column project-detail article
 *
 * Buttons reuse the shared `.nav-button`; white footers share one red
 * hover affordance, while the color-themed project-detail footer keeps its
 * per-project accent (see `.site-footer` rules in global.css).
 */
import { getEntry } from "astro:content";
// #1079: the /privacy/ link on every footer, rendered by the component only
// when the privacy flag is on (specs/analytics-privacy.md § UI Hooks).
import PrivacyLink from "./privacy/ui/PrivacyLink.astro";

interface FooterLink {
  href: string;
  label: string;
  /**
   * Marks an off-site destination. Renders `target="_blank" rel="noopener"`
   * per operating-rules.md § Coding Conventions. The flag is explicit rather
   * than inferred from the href, because an inference would silently start
   * opening new tabs the first time an internal link gained a protocol.
   */
  external?: boolean;
}

interface Props {
  /** Name before the "· <city>" byline. */
  attribution: string;
  /** Nav actions, left-to-right. Labels may include arrows (←/→). */
  links: FooterLink[];
  /** Placement/chrome modifier. */
  variant?: "grid" | "canvas" | "detail";
  /** Extra class(es), e.g. the resume canvas-collapse/print hook. */
  class?: string;
}

const { attribution, links, variant, class: extra } = Astro.props;

// The byline's city is the profile's locality (#1166), the same field the
// résumé header and both Person JSON-LD nodes read.
const myself = await getEntry("myself", "nathan-payne");
if (!myself) {
  throw new Error('Missing myself entry "nathan-payne" — expected at src/content/myself/nathan-payne.md');
}
const locality = myself.data.address.locality;

const classList = [
  "site-footer",
  variant ? `site-footer--${variant}` : null,
  extra ?? null,
]
  .filter(Boolean)
  .join(" ");
---

<footer class={classList}>
  <p class="site-footer__attribution">{attribution} &middot; {locality}</p>
  <nav class="site-footer__nav" aria-label="Footer navigation">
    {links.map((link) => (
      <a
        class="nav-button"
        href={link.href}
        {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
      >{link.label}</a>
    ))}
    <PrivacyLink class="nav-button" />
  </nav>
</footer>
