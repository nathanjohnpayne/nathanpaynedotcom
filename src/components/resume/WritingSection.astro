---
/**
 * WritingSection — a compact inline section (no collection; per #394 the
 * homepage and /blog already cover writing). Links the blog and a few
 * selected essays, using the site's → arrow convention.
 * Section/heading scaffolding via the shared ResumeSection wrapper (#471).
 */
import { getCollection, getEntry } from 'astro:content';
import ResumeSection from './ResumeSection.astro';
import { getSiteCopy } from '../../lib/site-copy';

// The publication's name and the résumé's introduction to it come from
// src/content/site-copy/blog.md, the entry /blog/ and the RSS feed also read;
// the link text is the `blog` field on the profile (#1166).
const publication = await getSiteCopy('blog');
const myself = await getEntry('myself', 'nathan-payne');
if (!myself) {
  throw new Error('Missing myself entry "nathan-payne" — expected at src/content/myself/nathan-payne.md');
}

// Curated, ordered selection: this list owns which essays appear and in what
// order, nothing else. Each display title is the post's own `title`, or its
// `resumeTitle` where the list deliberately shortens it ("The HTML Mock-up Is
// the Spec"), so a retitled post reaches the résumé (#1166). The ids are
// validated against the published blog collection, so a renamed or
// unpublished post fails the build instead of silently shipping a dead link
// (#552).
const ESSAY_IDS = [
  'agent-approval-workflow-genesis-of-mergepath',
  'six-prs-one-bug-agent-failure-modes',
  'html-mockups-as-spec',
];

const publishedPosts = new Map(
  (await getCollection('blog', ({ data }) => !data.draft)).map((post) => [post.id, post]),
);
const missingEssays = ESSAY_IDS.filter((id) => !publishedPosts.has(id));
if (missingEssays.length > 0) {
  throw new Error(
    `WritingSection: selected essay id(s) not in the published blog collection: ${missingEssays.join(', ')}`,
  );
}
const essays = ESSAY_IDS.map((id) => {
  const { data } = publishedPosts.get(id)!;
  return { id, title: data.resumeTitle ?? data.title };
});
---

<ResumeSection type="writing" heading="Writing"><p class="resume-writing__lead">
    <strong>{publication.title}—</strong><a href="/blog/">{myself.data.blog} <span class="link-arrow" aria-hidden="true">→</span></a>
  </p>
  <p class="resume-writing__desc">{publication.resumeDescription}</p>
  <p class="resume-writing__label">Selected essays:</p>
  <ul class="resume-writing__essays">
    {essays.map((essay) => (
      <li>
        <a href={`/blog/${essay.id}/`}>{essay.title} <span class="link-arrow" aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul></ResumeSection>
