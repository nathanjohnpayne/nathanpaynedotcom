---
/**
 * ProjectsSection — selected projects from the `resumeProjects` collection
 * (distinct from `projects`). Opens with a compact lead linking the /projects
 * index (the WritingSection tag/intro/link pattern), then each entry, in a
 * fixed anatomy: lifecycle kicker, name, tech list, destinations, description.
 * Section/heading scaffolding via the shared ResumeSection wrapper (#471).
 *
 * The section follows the same grammar as Writing (#947): heading,
 * proposition plus canonical URL, description, selected-items label, items.
 * The proposition slot used to hold "Selected Projects" — the LABEL, standing
 * where the claim belongs — which is why the section had no label row and
 * asserted nothing about itself. It now quotes the /projects/ headline from
 * src/lib/section-propositions.ts, so the résumé says about that page what the
 * page says about itself, and cannot drift from it.
 *
 * The name is deliberately NOT a link (#947). It is the entry's identity and
 * reads as typography; the row beneath it is where every destination lives, so
 * one line answers "where can I go from here" instead of the answer being
 * split between a heading that happens to be clickable and a row that is.
 * That row opens on the entry's case study; `.resume-projects__lead` routes
 * to the /projects/ index as a whole.
 */
import ResumeSection from './ResumeSection.astro';
import { getCollection, render } from 'astro:content';
import { stateMarkerClass } from '../../lib/lifecycle-marker';
import { PROJECTS_HEADING } from '../../lib/section-propositions';
import { liveLinkLabel } from '../../lib/live-link-label';
import { emDashJoint } from '../../lib/em-dash-joint';
import { getSiteCopy } from '../../lib/site-copy';

const { entries } = Astro.props;

// The introduction is the résumé rendition in src/content/site-copy/projects.md,
// beside the /projects/ metadata, social line and homepage introduction (#1166).
const { resumeDescription } = await getSiteCopy('projects');

// Lifecycle status, looked up by slug from the `projects` collection rather
// than restated here — a resume entry's id is its project slug.
//
// Carries the site's `.state-marker` geometry (#944), which this section used
// to withhold on the grounds that a PDF-bound, ATS-parsed page should not
// extend the visual language. That reasoning was aimed at the wrong risk: the
// mark is a `::before` box, so it adds no characters to the DOM or to the
// PDF's text layer, and the status *word* is unchanged either way. What the
// résumé actually lacked was the fourth surface of a vocabulary the homepage,
// /projects/, and the detail-page STATUS cell already speak.
//
// It renders as a kicker ABOVE the <h3>, which is the /projects/ card anatomy
// (`<p class="post-meta project-status">` over `<h2 class="post-title">`)
// rather than a new arrangement. Trailing the name was the obvious placement
// and it does not survive the longest entry: "Device Source of Truth—Partner
// Device Intelligence Platform" already fills 549 of the content column's 632
// px, so any status after it wraps to a line of its own — a stray "ARCHIVED"
// under a heading, at every viewport width. On its own line by design, the
// mark cannot be pushed off one, and the project name gets the full measure
// back. Every entry carries the kicker, including the four that say the same
// word: consistent card anatomy beats avoiding apparent redundancy, which is
// the call #285 already made for the index cards.
const projectMeta = Object.fromEntries(
  (await getCollection('projects', ({ data }) => !data.draft)).map((project) => [
    project.data.slug,
    { status: project.data.status, liveLabel: project.data.liveLabel },
  ]),
);
const projectStatus = Object.fromEntries(
  Object.entries(projectMeta).map(([slug, meta]) => [slug, meta.status]),
);

const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);

---

<ResumeSection type="projects" heading="Projects"><p class="resume-projects__lead">
    <strong>{PROJECTS_HEADING}</strong> · <a href="/projects/">nathanpayne.com/projects <span class="link-arrow" aria-hidden="true">→</span></a>
  </p>
  <p class="resume-projects__desc">{resumeDescription}</p>
  <p class="resume-projects__label">Selected projects:</p>
  {rendered.map(({ entry, Content }) => {
    const d = entry.data;
    // Name—descriptor, closed, and split for the same reason the Experience
    // heading is: an em dash may start a line otherwise (src/lib/em-dash-joint).
    const heading = emDashJoint(d.name);
    // Every destination the entry has: the case study first, then the live
    // app, then the repo (#947). This was `d.url ?? d.repo`, which silently
    // dropped the repo from every project that also had a live site — five of
    // the seven, once the missing repo and app URLs were added to the
    // collection. A résumé reader who wants the code and a reader who wants the
    // running product are different readers, and the card had been answering
    // only the second.
    //
    // The case study leads because it is the destination the section's own
    // introduction promises — the decisions, tradeoffs and evidence — and the
    // one a reader hiring a PM is there for. Before, it was reachable only by
    // going back up to the `/projects/` lead and finding the project again in
    // the index. Every entry has one (the claims-review stamp requires it), but
    // it is still read off the `projects` collection, so a project drafted out
    // of the build drops its link rather than pointing at a 404. It stays on
    // the site, so it takes the internal `→` and the current tab, where the
    // other two take `↗` and a new one.
    //
    // Each row's accessible name joins the project to its destination with the
    // site's `·`, not an em dash: every `d.name` already closes on one
    // ("Five Across—Live Multiplayer Social Bingo Platform"), and a second in
    // the same string reads as a typo rather than a break. That is the call the
    // section lead already makes against the same collision (specs/resume.md
    // § Dash punctuation), and it matches the `·` the visible row shows.
    const liveLabel = liveLinkLabel(projectMeta[entry.id]?.liveLabel);
    const destinations: { href: string; label: string; name: string; external: boolean }[] = [];
    if (projectMeta[entry.id]) {
      destinations.push({
        href: `/projects/${entry.id}/`,
        label: 'Case study',
        name: `${d.name} · case study`,
        external: false,
      });
    }
    if (d.url) {
      destinations.push({ href: d.url, label: liveLabel, name: `${d.name} · ${liveLabel.toLowerCase()}`, external: true });
    }
    if (d.repo) {
      destinations.push({ href: d.repo, label: 'GitHub', name: `${d.name} · source on GitHub`, external: true });
    }
    return (
      <article class="resume-entry">
        {projectStatus[entry.id] && (
          <p class={stateMarkerClass(projectStatus[entry.id], 'resume-entry__status')}>
            {projectStatus[entry.id]}
          </p>
        )}
        <h3 class="resume-entry__title">{heading.head}{heading.joint && <span class="em-dash-joint">{heading.joint}</span>}{heading.tail}</h3>
        <p class="resume-entry__tech">{d.tech.join(' · ')}</p>
        {destinations.length > 0 && (
          <p class="resume-entry__link">
            {destinations.map((dest, i) => (
              <>
                {i > 0 && <span class="resume-entry__link-sep" aria-hidden="true"> · </span>}
                {dest.external ? (
                  <a href={dest.href} target="_blank" rel="noopener" aria-label={dest.name}>
                    {dest.label} <span class="link-arrow" aria-hidden="true">&nearr;</span>
                  </a>
                ) : (
                  <a href={dest.href} aria-label={dest.name}>
                    {dest.label} <span class="link-arrow" aria-hidden="true">→</span>
                  </a>
                )}
              </>
            ))}
          </p>
        )}
        <div class="resume-prose">
          <Content />
        </div>
      </article>
    );
  })}
</ResumeSection>
