---
/**
 * ProjectHero — shared hero header for project detail pages (#470).
 *
 * Renders the #436 breadcrumb trail, the project `h1` + deck, and the
 * `.nav-button` CTA row inside the accent-tinted gradient band, closed by
 * the hero rule. Replaces the former HeroWide/HeroNarrow twins, which had
 * to be hand-synced and differed only in the wrapper modifier class.
 *
 * Props:
 * - `variant`: "wide" | "narrow" — sets `.project-hero--{variant}` on the
 *   wrapper. ProjectLayout derives it from `screenshotAspect`, so the hero
 *   modifier always matches the screenshot treatment below it. All inner
 *   markup is identical across variants; any visual divergence lives in
 *   the per-variant CSS in global.css.
 * - `title`: project headline rendered as the page `h1`.
 * - `deck`: one-line standfirst under the title.
 * - `breadcrumbLabel`: current-page (third) crumb; first two crumbs are
 *   fixed (home → Builds).
 * - `liveUrl` (optional): external product link — first CTA when present.
 * - `githubUrl`: repository link — always rendered.
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  variant: 'wide' | 'narrow';
  title: string;
  deck: string;
  breadcrumbLabel: string;
  liveUrl?: string;
  githubUrl: string;
}

const { variant, title, deck, breadcrumbLabel, liveUrl, githubUrl } = Astro.props;
---

<header class={`project-hero project-hero--${variant}`}>
  <div class="project-hero__gradient">
    <div class="project-hero__header">
      <Breadcrumbs
        class="breadcrumbs--inset"
        items={[
          { label: "Nathan Payne", href: "/" },
          { label: "Builds", href: "/projects/" },
          { label: breadcrumbLabel },
        ]}
      />
      <h1>{title}</h1>
      <p class="deck deck--inset">{deck}</p>
      <div class="project-actions">
        {liveUrl && (
          <a class="nav-button" href={liveUrl} target="_blank" rel="noopener noreferrer">View Live Product</a>
        )}
        <a class="nav-button" href={githubUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
      </div>
    </div>
  </div>
  <hr class="project-hero__rule" />
</header>
