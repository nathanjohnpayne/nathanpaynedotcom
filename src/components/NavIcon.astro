---
/**
 * NavIcon.astro — the content icon that leads a .nav-button label in the
 * shared footer and on the 404: it says what the destination is, where the
 * old ←/→ arrows only said "somewhere", and pointed both ways in one row.
 * Decorative (aria-hidden; the label, or the anchor's aria-label, names the
 * link). Inherits currentColor.
 *
 * `pencil-sparkles` marks writing and AI use (#1490): the footer's icon-only
 * "How I write" link (HowIWriteLink.astro), and the "AI use" link each piece
 * carries (#1493) reuses it from here.
 *
 * Lucide (https://lucide.dev, ISC) glyphs, transcribed verbatim from the
 * upstream source so a drift check is a byte comparison (as ContactIcon.astro
 * does):
 *   curl -s https://raw.githubusercontent.com/lucide-icons/lucide/main/icons/<name>.svg
 */
export type NavIconName =
  | 'file-user'
  | 'calendar'
  | 'newspaper'
  | 'layout-grid'
  | 'house'
  | 'shield-check'
  | 'pencil-sparkles'
  | 'palette'
  | 'phone';

interface Props {
  name: NavIconName;
}
const { name } = Astro.props;
---

<svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'file-user' && (
    <>
      <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path>
      <path d="M14 2v5a1 1 0 0 0 1 1h5"></path>
      <path d="M16 22a4 4 0 0 0-8 0"></path>
      <circle cx="12" cy="15" r="3"></circle>
    </>
  )}
  {name === 'calendar' && (
    <>
      <path d="M8 2v3"></path>
      <path d="M16 2v3"></path>
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <path d="M3 9h18"></path>
    </>
  )}
  {name === 'newspaper' && (
    <>
      <path d="M15 18h-5"></path>
      <path d="M18 14h-8"></path>
      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"></path>
      <rect width="8" height="4" x="10" y="6" rx="1"></rect>
    </>
  )}
  {name === 'layout-grid' && (
    <>
      <rect width="7" height="7" x="3" y="3" rx="1"></rect>
      <rect width="7" height="7" x="14" y="3" rx="1"></rect>
      <rect width="7" height="7" x="14" y="14" rx="1"></rect>
      <rect width="7" height="7" x="3" y="14" rx="1"></rect>
    </>
  )}
  {name === 'house' && (
    <>
      <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path>
      <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
      <path d="m9 12 2 2 4-4"></path>
    </>
  )}
  {name === 'pencil-sparkles' && (
    <>
      <path d="M10 3H8"></path>
      <path d="m15.007 5.008 3.987 3.986"></path>
      <path d="M20 15v4"></path>
      <path d="M21.174 6.813a2.82 2.82 0 0 0-3.986-3.987L3.842 16.175a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
      <path d="M22 17h-4"></path>
      <path d="M4 5v4"></path>
      <path d="M6 7H2"></path>
      <path d="M9 2v2"></path>
    </>
  )}
  {name === 'palette' && (
    <>
      <path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path>
      <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
      <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
      <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
      <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
    </>
  )}
  {name === 'phone' && (
    <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path>
  )}
</svg>
