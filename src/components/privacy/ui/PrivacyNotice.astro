---
/**
 * #1079 privacy notice (specs/analytics-privacy.md § UI Hooks, row "Notice").
 *
 * Rendered by PrivacyBody at the end of <body>, only when
 * privacyControlsEnabled(); notice.js moves it to the top of the body, first
 * in DOM and tab order. It floats as a small card fixed near the top of the
 * viewport, over a small region of the page: it rolls down on arrival and back
 * up when a choice or dismissal closes it (#1479). It is an <aside> with a
 * label, not a dialog: no backdrop, nothing is modal, nothing takes focus,
 * nothing locks scroll, and the page behind stays interactive. Both buttons
 * call window.npPrivacy and nothing else.
 *
 * The copy is Nathan's (2026-10-12, shortened 2026-10-31 to drop the one
 * sentence that leaned toward keeping analytics on). Its facts trace to docs/privacy/inventory.md
 * § Summary: analytics with session replay (PostHog) and video playback data
 * (Mux Data). The tools are named on /privacy/, one link away. It names no
 * retention period and makes no claim of anonymity, compliance, or "not sold"
 * (PRIV-11).
 *
 * Styles and the script are inlined rather than hoisted. Astro bundles a
 * component's <style> and <script> by import graph, so a hoisted one would be
 * emitted on every page of a build that left the flag off; inline, they exist
 * only in the HTML of a page that rendered this component, which keeps the
 * runtime markers to the inline gate of each page, as
 * tests/analytics-privacy.test.js requires (PRIV-15).
 * The same is why these rules are not in src/styles/global.css.
 */
import noticeSource from './notice.js?raw';
---

<style is:inline>
  /* A card laid on the page, not a band in it: fixed near the top, centered,
     at most 30rem wide, with a 12px margin to the viewport edges on phones.
     env(safe-area-inset-top) is 0 under the default viewport-fit and keeps it
     clear of a notch if the site ever sets viewport-fit=cover. The rail on
     its left edge takes the color before the page accent in the phone-stack
     rail cycle (src/lib/index-grid.ts), so it never matches the hero below. */
  .privacy-notice,
  .privacy-notice-status {
    --np-rail-w: 1rem;
    --np-edge: 0.75rem;
    position: fixed;
    top: calc(var(--np-edge) + env(safe-area-inset-top));
    left: var(--np-edge);
    right: var(--np-edge);
    max-width: 30rem;
    margin-inline: auto;
    background: var(--paper);
    color: var(--ink);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--ink) 18%, transparent);
    font-family: var(--font-body);
  }
  .privacy-notice {
    --np-rail: var(--accent-black);
    z-index: 11;
  }
  [data-accent='blue'] .privacy-notice {
    --np-rail: var(--red);
  }
  [data-accent='yellow'] .privacy-notice {
    --np-rail: var(--blue);
  }
  [data-accent='black'] .privacy-notice {
    --np-rail: var(--yellow);
  }
  .privacy-notice::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--np-rail-w);
    background: var(--np-rail);
    border-right: 3px solid var(--ink);
  }
  /* Arrival: the card rolls down from above the viewport edge, then its rail
     draws in once, the only attention cue. Leaving (.is-leaving, set by
     notice.js before it hides the card) rolls it back up. Only transform,
     opacity and the rail's width move. The card takes no space in the page,
     so neither motion shifts layout. */
  @keyframes np-privacy-roll-down {
    from {
      opacity: 0;
      transform: translateY(calc(-100% - var(--np-edge) - env(safe-area-inset-top)));
    }
  }
  @keyframes np-privacy-roll-up {
    to {
      opacity: 0;
      transform: translateY(calc(-100% - var(--np-edge) - env(safe-area-inset-top)));
    }
  }
  @keyframes np-privacy-rail-in {
    from {
      width: 0;
    }
  }
  @keyframes np-privacy-fade-in {
    from {
      opacity: 0;
    }
  }
  .privacy-notice:not([hidden]) {
    animation: np-privacy-roll-down var(--motion-plane) var(--ease-sharp) both;
  }
  .privacy-notice:not([hidden])::before {
    animation: np-privacy-rail-in var(--motion-load) var(--ease-out) var(--motion-plane) both;
  }
  .privacy-notice.is-leaving {
    animation: np-privacy-roll-up var(--motion-load) var(--ease-standard) both;
    pointer-events: none;
  }
  .privacy-notice-status:not(:empty) {
    animation: np-privacy-fade-in var(--motion-load) var(--ease-standard) both;
  }
  /* Reduced motion: nothing moves. The card appears and leaves at once and
     the rail is simply there (PRIV-6); notice.js sees no animation and hides
     the card immediately. */
  @media (prefers-reduced-motion: reduce) {
    .privacy-notice:not([hidden]),
    .privacy-notice:not([hidden])::before,
    .privacy-notice.is-leaving,
    .privacy-notice-status:not(:empty) {
      animation: none;
    }
  }
  /* The copy, then the two choices side by side under it at every width. */
  .privacy-notice__inner {
    display: grid;
    gap: var(--sp-md);
    padding: var(--sp-lg) var(--sp-lg) var(--sp-lg) calc(var(--np-rail-w) + 3px + var(--sp-lg));
  }
  .privacy-notice__copy {
    min-width: 0;
  }
  .privacy-notice__title {
    margin-bottom: var(--sp-xs);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-62);
  }
  /* The question names both choices, so the card asks for a decision
     without leaning toward either answer. */
  .privacy-notice__question {
    margin-bottom: var(--sp-xs);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    line-height: 1.2;
  }
  .privacy-notice__text {
    font-size: clamp(0.85rem, 0.84rem + 0.1vw, 0.92rem);
    line-height: 1.5;
  }
  .privacy-notice__text a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  /* Two equal choices: both tracks are 1fr and both buttons share one
     style, so turning analytics off is exactly as large and as visible as
     keeping them on. Each target is at least 44px tall (WCAG 2.5.5). */
  .privacy-notice__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  .privacy-notice .nav-button {
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.6rem 0.7rem;
    font-family: var(--font-body);
    line-height: 1.25;
    text-align: center;
    cursor: pointer;
  }
  /* No accent fill here: the site's .nav-button hover/focus swap paints the
     page accent (yellow on some project pages), which made one choice look
     selected. Hover is a light ink tint on either button.
     "Keep analytics on" carries a permanent double line: a bold outer border
     and a thin inner line, drawn by an inset shadow whose gap takes the
     button's own background (--np-button-bg), so the gap stays clean on hover.
     Keyboard focus is deliberately unlike any line: a solid ink fill with a
     light label, so focus can never be mistaken for that resting border. */
  .privacy-notice .nav-button {
    --np-button-bg: var(--paper);
    background: var(--np-button-bg);
    /* Color changes are instant, so the focus fill is never caught halfway;
       only the site's hover lift eases. */
    transition: transform var(--motion-hover) var(--ease-standard);
  }
  .privacy-notice .nav-button:hover {
    --np-button-bg: color-mix(in srgb, var(--ink) 8%, var(--paper));
    background: var(--np-button-bg);
    color: var(--ink);
  }
  .privacy-notice .nav-button[data-np-privacy-action='dismiss'] {
    border: 3px solid var(--ink);
    box-shadow:
      inset 0 0 0 2px var(--np-button-bg),
      inset 0 0 0 3px var(--ink);
  }
  .privacy-notice .nav-button:focus-visible {
    --np-button-bg: var(--ink);
    /* Transparent, so invisible here, but forced-colors mode (which drops
       the fill) paints it, so focus stays visible there too. */
    outline: 3px solid transparent;
    outline-offset: 3px;
    background: var(--np-button-bg);
    color: var(--paper);
  }
  /* Too narrow for both labels side by side (a phone-width card): stack
     them, full width, turning analytics off first, so neither wraps or
     shrinks. Sized on the card, not the viewport, since the card stops
     growing at 30rem. */
  .privacy-notice__inner {
    container-type: inline-size;
  }
  @container (max-width: 26rem) {
    .privacy-notice__actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* The smallest phones: the question already names the topic, so the
     eyebrow is hidden visually (it still names the card for assistive
     technology through aria-labelledby) and the gaps tighten, keeping the
     card off most of a 320px screen. */
  @container (max-width: 18rem) {
    .privacy-notice__title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .privacy-notice__actions {
      gap: var(--sp-sm);
    }
  }
  /* The announcement after a choice lands where the card was, as a smaller
     card under it, so the card rolling up reveals it. */
  .privacy-notice-status {
    z-index: 10;
    padding: var(--sp-sm) var(--sp-md);
    font-size: clamp(0.85rem, 0.83rem + 0.1vw, 0.92rem);
    line-height: 1.5;
    text-align: center;
  }
  .privacy-notice-status:empty {
    display: none;
  }
  .privacy-notice-status a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .privacy-notice-status a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .privacy-notice-status:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -4px;
  }
  /* The notice is a screen control. With the flag on, the build-time résumé
     PDF render (src/integrations/resume-pdf.mjs) is a first visit in a fresh
     browser profile, so it showed the notice at the top of the PDF (#1233). */
  @media print {
    .privacy-notice,
    .privacy-notice-status {
      display: none;
    }
  }
</style>

<aside
  id="np-privacy-notice"
  class="privacy-notice"
  data-np-privacy-ui="notice"
  aria-labelledby="np-privacy-notice-title"
  hidden
>
  <div class="privacy-notice__inner">
    <div class="privacy-notice__copy">
      <p class="privacy-notice__title" id="np-privacy-notice-title">Analytics on this site</p>
      <p class="privacy-notice__question">Keep analytics on, or turn them off?</p>
      <p class="privacy-notice__text">
        This personal site uses analytics, including session replay and video playback data, to see what's working. You can turn them off anytime. <a href="/privacy/">Privacy details</a>.
      </p>
    </div>
    <div class="privacy-notice__actions">
      <button type="button" class="nav-button" data-np-privacy-action="deny">Turn analytics off</button>
      <button type="button" class="nav-button" data-np-privacy-action="dismiss">Keep analytics on</button>
    </div>
  </div>
</aside>
<p id="np-privacy-notice-status" class="privacy-notice-status" role="status" tabindex="-1"></p>

<script is:inline set:html={noticeSource} />
