---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { estimateReadingMinutes } from '../../lib/reading-time';
import { getBlogLastUpdated, lastUpdatedFor } from '../../../scripts/lib/blog-last-updated.mjs';

export async function getStaticPaths() {
  // Prev/next stays newest first by date (#622, #627). The blog index now has
  // an editorial order, but narrative navigation is a separate concern and
  // deliberately remains chronological.
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  // Neighbor summary for the end-of-post nav cards. Bare "min" matches the
  // /blog/ index cards (the post's own metadata panel uses "min read").
  const summarize = (post: CollectionEntry<'blog'> | undefined) =>
    post
      ? {
          title: post.data.title,
          href: `/blog/${post.id}/`,
          readingTime: `${estimateReadingMinutes(post.body)} min`,
        }
      : null;

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // Newest-first array: the older neighbor sits after this post,
      // the newer one before it. The ends omit the missing side rather
      // than wrapping around the collection.
      prevPost: summarize(posts[index + 1]),
      nextPost: summarize(posts[index - 1]),
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;

// Astro's render() provides headings built-in — no custom plugin needed.
// headings: { depth: number; slug: string; text: string }[]
const { Content, headings } = await render(post);

// Shared estimator with src/pages/blog/index.astro — see src/lib/reading-time.ts
// for algorithm. The "min read" suffix is post-page-specific (the listing
// uses bare "min").
const readingTime = `${estimateReadingMinutes(post.body)} min read`;

// Derived from git history, never authored (#1168, specs/last-updated.md).
// The build fails rather than guess when the history is missing.
if (!post.filePath) throw new Error(`Blog entry ${post.id} has no filePath to date`);
const updated = lastUpdatedFor(getBlogLastUpdated(), post.filePath);
---

<BlogPost
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  shortTitle={post.data.shortTitle}
  description={post.data.description}
  seoDescription={post.data.seoDescription}
  author={post.data.author}
  date={post.data.date}
  updated={updated}
  tags={post.data.tags}
  image={post.data.image}
  readingTime={readingTime}
  headings={headings}
  keyTakeaways={post.data.keyTakeaways}
  pullquotes={post.data.pullquotes}
  sidebar={post.data.sidebar}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
