  <script is:inline>
    (function () {
      'use strict';

      const grid = document.getElementById('mondrian');
      if (!grid) return;

      const panels = Array.from(grid.querySelectorAll('.panel'));

      // Track cursor position so we can re-resolve what's under the
      // pointer after a grid morph completes (#313). lastMoveX/Y are
      // updated only on real cursor movement so phantom mouseenter
      // events (panel shifting under a stationary cursor) leave the
      // values where they were.
      let lastMoveX = null;
      let lastMoveY = null;
      document.addEventListener('mousemove', (event) => {
        lastMoveX = event.clientX;
        lastMoveY = event.clientY;
      }, { passive: true });

      // Feature-detect matchMedia so the script doesn't throw in
      // environments without it (jsdom under vitest, very old UAs).
      const matchesQuery = (q) => (typeof window.matchMedia === 'function' ? window.matchMedia(q).matches : false);
      const canHover = () => matchesQuery('(hover: hover) and (pointer: fine)');
      // Below --bp-stack (1024px) the page renders the vertical stack
      // and panel interactions are disabled — the stack already shows
      // all content. Kept in sync with the @media (max-width: 1023px)
      // block in src/styles/global.css and the matchMedia string
      // asserted in tests/responsive-layout.test.js. Issue #313.
      const mobile = () => matchesQuery('(max-width: 1023px)');

      function readMsToken(name, fallback) {
        // prefers-reduced-motion zeroes CSS transition durations via the
        // universal `* { transition-duration: 0 }` rule. The state
        // machine drives content reveal off setTimeout, so without
        // mirroring that here, reduced-motion users would sit through
        // delayed phase transitions with no visible motion. Return 0 so
        // every phase completes synchronously. (#314, Codex CLI P2
        // finding from nathanpayne-codex)
        if (matchesQuery('(prefers-reduced-motion: reduce)')) return 0;
        const raw = getComputedStyle(grid).getPropertyValue(name).trim();
        if (!raw) return fallback;
        if (raw.endsWith('ms')) return parseFloat(raw) || fallback;
        if (raw.endsWith('s')) return (parseFloat(raw) || fallback / 1000) * 1000;
        return parseFloat(raw) || fallback;
      }

      // Interaction state machine (#313). Decouples geometry from content
      // reveal so the user perceives one intentional Mondrian
      // rearrangement instead of implementation states (blank cream
      // surfaces, content popping in mid-morph).
      //
      //   idle     : no panel open. Hover armed.
      //   opening  : grid morphing to the chosen panel. Content not yet
      //              visible. Hover suppressed; intent queued.
      //   open     : morph done; content visible. Hover armed for switch.
      //   switching: previous panel's content fading out, then grid
      //              morphs from one focus state to the next, then new
      //              panel's content fades in. Hover suppressed.
      //   closing  : current panel's content fading out, then grid
      //              morphing back to rest. Hover suppressed.
      //
      // Hover events that arrive while the state is anything other than
      // `idle` or `open` are queued (we just remember the cursor's last
      // position via the mousemove listener above). Whenever a transient
      // state lands in idle or open, we re-resolve the target via
      // document.elementFromPoint(lastMoveX, lastMoveY) and act on the
      // pointer's *current* location — not on a stale mouseenter.
      //
      // Click / keyboard / focus paths bypass the state guard because
      // they're deliberate user intent.
      let state = 'idle';
      let active = null;
      // transitionToken invalidates stale setTimeout callbacks when a
      // new transition starts mid-flight (e.g. user opens A, then
      // immediately opens B before A's morph completes). Each phase
      // checks its captured token against the current one.
      let transitionToken = 0;
      // Brief, cancellable close delay so a normal cursor move from one
      // panel to another doesn't flash through `closing` before the
      // direct-switch shortcut in mouseleave can fire. Tuned short — long
      // enough to bridge a single mouseenter event hop, short enough that
      // a true cursor exit (to the dark grid background) still closes
      // promptly. (#314, Codex CLI P1 finding)
      const leaveDelay = 80;
      let leaveTimer = null;

      function resolveHoverTarget() {
        if (!canHover()) return;
        if (lastMoveX === null || lastMoveY === null) return;
        const target = document.elementFromPoint(lastMoveX, lastMoveY);
        const panel = target ? target.closest('.panel') : null;
        if (panel) {
          if (panel !== active) requestPanel(panel);
        } else if (active) {
          requestClose();
        }
      }

      function requestPanel(panel) {
        if (mobile()) return;
        if (panel === active) return;
        if (state === 'opening' || state === 'switching' || state === 'closing') return;
        // Hover-driven path: pass `replayHover = true` so the post-morph
        // settle re-checks elementFromPoint. That's the wobble-killing
        // dance for hover. Click / keyboard / focus take the openPanel
        // entry point and pass false — replaying hover after a deliberate
        // explicit-intent open could otherwise switch away from the
        // panel the user just chose if the cursor happens to be over a
        // different one. (#313, P2 finding from Codex review)
        if (active) startSwitch(panel, true);
        else startOpen(panel, true);
      }

      function requestClose() {
        if (mobile()) return;
        if (state !== 'open') return;
        if (!active) return;
        startClose(true);
      }

      // Take the panel-label out of the keyboard tab order and a11y
      // tree while its panel is open. Visually the label is opacity 0,
      // but without these flags a keyboard user could still Tab onto an
      // invisible button. (#314, Codex CLI P3 finding) The original
      // tabindex / aria values are stashed so we can restore them on
      // close even if the markup conventions change in the future.
      function hideLabel(panel) {
        const label = panel.querySelector('.panel-label');
        if (!label) return;
        if (label.dataset.tabindexRestore === undefined) {
          label.dataset.tabindexRestore = label.getAttribute('tabindex') || '';
        }
        label.setAttribute('tabindex', '-1');
        label.setAttribute('aria-hidden', 'true');
      }
      function showLabel(panel) {
        const label = panel.querySelector('.panel-label');
        if (!label) return;
        const restore = label.dataset.tabindexRestore;
        if (restore !== undefined) {
          if (restore === '') label.removeAttribute('tabindex');
          else label.setAttribute('tabindex', restore);
        }
        label.removeAttribute('aria-hidden');
      }

      function startOpen(panel, replayHover) {
        const token = ++transitionToken;
        state = 'opening';
        active = panel;
        panel.classList.add('is-open');
        hideLabel(panel);
        grid.dataset.focus = panel.dataset.panel;
        // After the grid morph settles, reveal content.
        setTimeout(() => {
          if (token !== transitionToken) return;
          panel.classList.add('is-content-visible');
          state = 'open';
          if (replayHover) resolveHoverTarget();
        }, readMsToken('--motion-plane', 460));
      }

      function startSwitch(nextPanel, replayHover) {
        const token = ++transitionToken;
        const prev = active;
        state = 'switching';
        // Phase 1: fade previous content out.
        prev.classList.remove('is-content-visible');
        setTimeout(() => {
          if (token !== transitionToken) return;
          // Phase 2: hand off the cream surface to the next panel and
          // morph the grid into its focus state. is-open transitions
          // colour; data-focus drives row/column tracks.
          prev.classList.remove('is-open');
          showLabel(prev);
          active = nextPanel;
          nextPanel.classList.add('is-open');
          hideLabel(nextPanel);
          grid.dataset.focus = nextPanel.dataset.panel;
          setTimeout(() => {
            if (token !== transitionToken) return;
            // Phase 3: fade the new content in once the grid is settled.
            nextPanel.classList.add('is-content-visible');
            state = 'open';
            if (replayHover) resolveHoverTarget();
          }, readMsToken('--motion-plane', 460));
        }, readMsToken('--motion-fast', 130));
      }

      function startClose(replayHover) {
        const token = ++transitionToken;
        const closing = active;
        state = 'closing';
        // Phase 1: fade content out first.
        closing.classList.remove('is-content-visible');
        setTimeout(() => {
          if (token !== transitionToken) return;
          // Phase 2: tear down focus state — grid morphs back to rest,
          // panel colour returns to its base hue, label fades in.
          closing.classList.remove('is-open');
          showLabel(closing);
          active = null;
          delete grid.dataset.focus;
          setTimeout(() => {
            if (token !== transitionToken) return;
            state = 'idle';
            if (replayHover) resolveHoverTarget();
          }, readMsToken('--motion-plane', 460));
        }, readMsToken('--motion-fast', 130));
      }

      // Click / keyboard / focus open and close. These bypass the
      // state-machine guard so deliberate user intent always works,
      // and they pass `replayHover = false` so the post-morph settle
      // does not re-resolve elementFromPoint and switch away from the
      // panel the user just chose. (#313, Codex P2 finding)
      function openPanel(panel) {
        if (mobile()) return;
        if (panel === active) return;
        if (active) startSwitch(panel, false);
        else startOpen(panel, false);
      }

      function closePanel() {
        if (!active) return;
        startClose(false);
      }

      // Content-height measurement (#313). Animated grid-template-rows
      // states use explicit, interpolable lengths instead of `auto` so
      // the morph never goes through a 0-length frame when content loses
      // its in-flow contribution. Each panel's natural content height is
      // measured once on load (after fonts settle) and on resize, then
      // exposed as `--cell-h-<panel>` for the focus-state CSS to consume.
      // The measurement applies the actual focus state's data-focus +
      // is-open + is-content-visible classes so column widths and content
      // wrap match what the user will see.
      function measureContentHeights() {
        if (mobile()) return;
        const restoredFocus = grid.dataset.focus;
        const restoredActive = active;
        const restoredVisible = restoredActive && restoredActive.classList.contains('is-content-visible');
        // Suppress transitions during the measure pass so flickers don't
        // hit first paint. See .mondrian.is-measuring in global.css.
        grid.classList.add('is-measuring');
        panels.forEach((panel) => {
          const key = panel.dataset.panel;
          const wasOpen = panel.classList.contains('is-open');
          const wasVisible = panel.classList.contains('is-content-visible');
          grid.dataset.focus = key;
          panel.classList.add('is-open', 'is-content-visible');
          void panel.offsetHeight;
          const ci = panel.querySelector('.content-inner');
          if (ci) {
            grid.style.setProperty('--cell-h-' + key, Math.ceil(ci.scrollHeight) + 'px');
          }
          if (!wasOpen) panel.classList.remove('is-open');
          if (!wasVisible) panel.classList.remove('is-content-visible');
        });
        if (restoredFocus) grid.dataset.focus = restoredFocus;
        else delete grid.dataset.focus;
        if (restoredActive) {
          restoredActive.classList.add('is-open');
          if (restoredVisible) restoredActive.classList.add('is-content-visible');
        }
        void grid.offsetHeight;
        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(() => grid.classList.remove('is-measuring'));
        } else {
          grid.classList.remove('is-measuring');
        }
      }

      // Run after fonts load (heights depend on Cormorant Garamond's
      // metrics) and re-run on resize because column widths in each
      // focus state are fr-based and content reflows.
      if (typeof document !== 'undefined' && document.fonts && document.fonts.ready) {
        document.fonts.ready.then(measureContentHeights);
      } else {
        measureContentHeights();
      }
      let resizeTimer = null;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(measureContentHeights, 150);
      });

      panels.forEach((panel) => {
        // Hover paths go through the state-machine guard (requestPanel /
        // requestClose). While the grid is opening / switching / closing,
        // hover events are ignored; the post-transition
        // resolveHoverTarget re-checks the actual pointer location.
        panel.addEventListener('mouseenter', () => {
          if (!canHover()) return;
          // Cancel any pending close — cursor came back onto a panel
          // before the leave-delay expired.
          clearTimeout(leaveTimer);
          requestPanel(panel);
        });
        panel.addEventListener('mouseleave', (event) => {
          if (!canHover()) return;
          // If the cursor is moving directly to another panel, treat it
          // as a switch rather than a close-through-idle. mouseleave
          // fires before the next panel's mouseenter, so without this
          // shortcut the state machine would enter `closing`, ignore the
          // subsequent requestPanel as a no-op, and only land on the
          // target panel after the close fully unwinds. (#314, Codex CLI
          // P1 finding from nathanpayne-codex)
          const next = event.relatedTarget && event.relatedTarget.nodeType === 1
            ? event.relatedTarget.closest('.panel')
            : null;
          if (next && next !== panel) {
            clearTimeout(leaveTimer);
            requestPanel(next);
            return;
          }
          // Otherwise schedule a brief, cancellable close. If the cursor
          // re-enters this panel (or any other panel) before the timer
          // fires, the close is cancelled and we either stay open or
          // switch — never a flash through idle.
          clearTimeout(leaveTimer);
          leaveTimer = setTimeout(() => requestClose(), leaveDelay);
        });
        panel.addEventListener('focusin', () => openPanel(panel));
        panel.addEventListener('focusout', (event) => {
          if (!panel.contains(event.relatedTarget)) closePanel();
        });
        panel.addEventListener('click', (event) => {
          if (event.target.closest('a')) return;
          if (mobile()) return;
          openPanel(panel);
        });
        panel.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closePanel();
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            openPanel(panel);
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (mobile()) return;
        if (!event.target.closest('.panel')) closePanel();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePanel();
      });

      window.addEventListener('resize', () => {
        if (mobile()) closePanel();
      });

      let scrollTimer = null;
      window.addEventListener('scroll', () => {
        document.body.classList.add('is-scrolling');
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          document.body.classList.remove('is-scrolling');
        }, 100);
      });

      panels.forEach((panel) => {
        let tracked = false;
        panel.addEventListener('mouseenter', () => {
          if (!canHover() || tracked || typeof gtag !== 'function') return;
          tracked = true;
          gtag('event', 'section_view', {
            section_name: panel.dataset.panel,
            event_category: 'engagement'
          });
        });
      });

      // ─── Community label horizontal/vertical aria toggle (#304) ───
      // The cross-fade itself is CSS-driven (opacity transitions keyed
      // off [data-focus] on the grid). JS only flips aria-hidden on the
      // two label variants so screen readers announce exactly one.
      const communityPanel = grid.querySelector('.panel--black');
      const labelH = communityPanel && communityPanel.querySelector('.panel-label__h');
      const labelV = communityPanel && communityPanel.querySelector('.panel-label__v');

      function syncCommunityLabelAria() {
        if (!labelH || !labelV) return;
        // Vertical only when Builds (data-focus="projects") is
        // open — that's the only expansion that compresses Community
        // narrow enough to truncate "COMMUNITY". Match the CSS rule.
        const useVertical = grid.dataset.focus === 'projects';
        labelH.setAttribute('aria-hidden', useVertical ? 'true' : 'false');
        labelV.setAttribute('aria-hidden', useVertical ? 'false' : 'true');
      }
      syncCommunityLabelAria();

      // Keep aria-hidden in lockstep with the grid's data-focus
      // attribute (which openPanel/closePanel already manage). A
      // MutationObserver avoids having to thread the call into each
      // existing call site.
      new MutationObserver(syncCommunityLabelAria)
        .observe(grid, { attributes: true, attributeFilter: ['data-focus'] });

      // ─── On-load discoverability pulse sequence (#305) ───
      // Four primary panels pulse clockwise once on initial load:
      // red (Nathan Payne) → yellow (Builds) → blue (Connect)
      // → black (Community). Total ~1.4s, fired once per page load,
      // deferred until the tab is visible. Reduced-motion users get
      // the persistent cursor-pointer affordance only.
      const reduceMotion = matchesQuery('(prefers-reduced-motion: reduce)');
      const PULSE_ORDER = ['panel--red', 'panel--yellow', 'panel--blue', 'panel--black'];
      // Read spec-locked timings from CSS custom properties so the
      // values stay controllable from one place (src/styles/global.css
      // :root) and the JS doesn't drift from the CSS keyframe duration.
      // Vite/lightningcss minifies durations to whichever serialization
      // is shorter — `700ms` is emitted as `.7s` in production — so the
      // parser has to honor both units. parseFloat alone would read
      // `.7s` as 0.7 and collapse the entire 1.4s sequence to 1.4ms.
      const motionTokens = getComputedStyle(document.documentElement);
      const readMs = (name, fallback) => {
        const raw = motionTokens.getPropertyValue(name).trim();
        const m = raw.match(/^([+-]?[\d.]+)\s*(ms|s)\s*$/i);
        if (!m) return fallback;
        const n = parseFloat(m[1]);
        if (!Number.isFinite(n)) return fallback;
        return m[2].toLowerCase() === 's' ? n * 1000 : n;
      };
      const PULSE_INITIAL_DELAY = readMs('--pulse-initial-delay', 300);
      const PULSE_INTERVAL = readMs('--pulse-interval', 370);
      const PULSE_DURATION = readMs('--pulse-duration', 250);
      // Outer cap: BaseLayout's font gate falls open after 1500ms even if
      // document.fonts.ready never resolves; pulse should still fire in
      // that case, just from the failsafe path.
      const FONTS_READY_FAILSAFE = 1700;
      let pulseFired = false;

      function pulsePanel(className) {
        const target = grid.querySelector('.' + className);
        if (!target) return;
        target.classList.add('panel--pulsing');
        setTimeout(() => target.classList.remove('panel--pulsing'), PULSE_DURATION);
      }

      function runPulseSequence() {
        if (pulseFired || reduceMotion) return;
        pulseFired = true;
        // Wait for the panel labels to settle before pulsing. Fonts.ready
        // resolves once Cormorant Garamond is loaded; the labels then
        // fade in over --motion-hover (~170ms); --pulse-initial-delay
        // (~300ms) gives the page a visible breath before motion starts.
        // Failsafe: if document.fonts is unavailable or never resolves,
        // fire after FONTS_READY_FAILSAFE so the discoverability cue
        // doesn't get stranded.
        let scheduled = false;
        const start = function () {
          if (scheduled) return;
          scheduled = true;
          PULSE_ORDER.forEach(function (className, i) {
            setTimeout(function () { pulsePanel(className); }, PULSE_INITIAL_DELAY + i * PULSE_INTERVAL);
          });
        };
        if (document.fonts && document.fonts.ready && typeof document.fonts.ready.then === 'function') {
          document.fonts.ready.then(start);
          setTimeout(start, FONTS_READY_FAILSAFE);
        } else {
          start();
        }
      }

      if (document.visibilityState === 'visible') {
        runPulseSequence();
      } else {
        // Loaded in a background tab — wait until the user surfaces
        // the page so the discoverability cue isn't missed.
        const onVisible = () => {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onVisible);
          runPulseSequence();
        };
        document.addEventListener('visibilitychange', onVisible);
      }
    })();
  </script>

  <script is:inline>
    (function () {
      // ── PostHog event tracking ──────────────────────────────────────────

      // Panel opened: observe data-focus changes on the Mondrian grid.
      // data-focus is also cycled by measureContentHeights() across every
      // panel on load and on resize, then restored — so a naive observer
      // emits phantom opens (and duplicates) for panels the visitor never
      // touched. Dedupe against the last captured panel and read the current
      // focus rather than per-mutation values: a measurement pass that
      // restores the same focus (or clears it) then captures nothing.
      const phGrid = document.getElementById('mondrian');
      if (phGrid) {
        let phLastPanel = null;
        new MutationObserver(function () {
          const focus = phGrid.dataset.focus;
          if (!focus) { phLastPanel = null; return; }
          if (focus === phLastPanel) return;
          phLastPanel = focus;
          window.posthog?.capture('homepage_panel_opened', { panel_name: focus });
        }).observe(phGrid, { attributes: true, attributeFilter: ['data-focus'] });
      }

      // Contact email clicked
      const mailto = document.getElementById('availability-mailto');
      if (mailto) {
        mailto.addEventListener('click', function () {
          window.posthog?.capture('contact_email_clicked');
        });
      }

      // Booking link clicked (Connect availability line, #620)
      document.querySelectorAll('.availability-booking').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('booking_link_clicked');
        });
      });

      // Resume link clicked — all résumé links in the Connect and About
      // panels: the About-panel NOW exit line, the Connect availability link,
      // and the Connect "Elsewhere" social-stack row. The social row also matches
      // .social-row below, so it intentionally fires both resume_link_clicked
      // (location-agnostic résumé aggregate) and social_link_clicked
      // {platform:"resume"} (social-stack row breakdown) — they answer
      // different questions.
      document.querySelectorAll('.availability-resume, .about-resume-link, .social-row--resume').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('resume_link_clicked');
        });
      });

      // Social link clicked
      document.querySelectorAll('.social-row').forEach(function (el) {
        el.addEventListener('click', function () {
          const match = el.className.match(/social-row--(\w+)/);
          window.posthog?.capture('social_link_clicked', {
            platform: match ? match[1] : 'unknown'
          });
        });
      });

      // Donation link clicked (Community panel)
      document.querySelectorAll('.effort-link').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('donation_link_clicked', {
            organization: (el.textContent || '').replace('→', '').trim()
          });
        });
      });

      // Writing link clicked (About panel)
      document.querySelectorAll('.writing-list a').forEach(function (el) {
        el.addEventListener('click', function () {
          window.posthog?.capture('writing_link_clicked', {
            href: el.getAttribute('href') || ''
          });
        });
      });
    })();
  </script>
</BaseLayout>
