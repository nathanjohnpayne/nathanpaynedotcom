---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { compareBlogPosts } from '../lib/blog-order';
import { stateMarkerClass } from '../lib/lifecycle-marker';
import { PROJECTS_RIBBON, PROJECT_DOMAINS, STACK_CAP } from '../lib/projects-ribbon';

// One published collection feeds two deliberately different surfaces (#627):
// the Writing list is editorial, while Latest Post remains chronological.
const publishedPosts = await getCollection('blog', ({ data }) => !data.draft);
const chronologicalPosts = [...publishedPosts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const editorialPosts = [...publishedPosts].sort(compareBlogPosts);

// The Builds grid below is hand-authored markup (see the comment above it), so
// its sequence is maintained by hand against the canonical order. Its lifecycle
// labels are NOT: they are looked up from each project's own frontmatter, so a
// status change on a project page reaches this surface without anyone
// remembering to come here. #892.
const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
const projectStatus = Object.fromEntries(
  projectEntries.map((project) => [project.data.slug, project.data.status]),
);
// Fail closed rather than degrade. A hard-coded slug that is renamed or marked
// draft would otherwise render a row with an empty status pointing at a page
// `[slug].astro` no longer generates — a dead link and a missing state, both
// silent. The build is the right place to notice (#893).
const statusOf = (slug: string) => {
  const status = projectStatus[slug];
  if (!status) {
    throw new Error(
      `Homepage Builds grid lists "${slug}", which is not a published project. ` +
        `Remove the row, or un-draft/rename the entry in src/content/projects/. ` +
        `Published: ${Object.keys(projectStatus).sort().join(', ')}`,
    );
  }
  return status;
};
// Lifecycle marker, borrowing the decision ledger's geometry so state reads the
// same way in both places: filled = done, outline = not running, half = partial.
// The paper grammar this keeps distinct — underlined/arrowed text navigates, an
// outlined rectangle is a control, glyph + uppercase text is state — is why the
// label carries no border of its own (#892). The status → mark mapping is
// shared with /projects/ and the detail-page STATUS cell; see
// src/lib/lifecycle-marker.ts for why it is one module rather than three copies.
const statusClass = (slug: string) => stateMarkerClass(statusOf(slug), 'p-status');

const latestPost = chronologicalPosts[0];

// Selected Projects STACK, as a degradation ladder rather than one fixed list
// (#930). The Builds panel's usable width is set by the Mondrian square, and
// that square is sized from viewport HEIGHT, not width — so the same list is
// comfortably one line on a 1440p display and two lines on a laptop. `tier` is
// the shortest rung an item survives to; the container queries on
// `.stack-items` in global.css drop the highest tiers first as the line
// narrows. Read the array in order and the ladder falls out of it: every
// shorter rung is this sequence with the over-tier items removed, so one DOM
// order renders all five rungs and nothing reorders on the way down.
//
//   10  TypeScript React Firebase "Cloudflare Workers" Playwright
//       "GitHub Actions" Anthropic OpenAI "Claude Code" Codex
//    9  drops Playwright        8  drops GitHub Actions
//    7  drops Cloudflare Workers        6  drops OpenAI
//
// The floor is editorial, not a fit guarantee: six items need ~37em, and a
// ribbon narrower than that (phones) wraps. Six is the point below which the
// line stops showing range, which is the only thing it is here to do.
const stackLadder = [
  { label: 'TypeScript', tier: 6 },
  { label: 'React', tier: 6 },
  { label: 'Firebase', tier: 6 },
  { label: 'Cloudflare Workers', tier: 8 },
  { label: 'Playwright', tier: 10 },
  { label: 'GitHub Actions', tier: 9 },
  { label: 'Anthropic', tier: 6 },
  { label: 'OpenAI', tier: 7 },
  { label: 'Claude Code', tier: 6 },
  { label: 'Codex', tier: 6 },
];

// Under 'stack' the ladder is capped server-side at its rung-6 floor (#984), so
// every shipped item is a rung-6 item and the container queries above never
// have a higher tier to re-show. The ladder array keeps all ten and its full
// tiering: the switch is meant to be flipped, and flipping it back has to
// restore #930 exactly rather than a trimmed copy of it.
const cappedStackLadder = stackLadder.filter((item) => item.tier <= STACK_CAP);

// Under 'domains' the footer says what the intro used to (#984), so the intro
// stops saying it. One paragraph with a conditional opening sentence rather
// than two copies of it — the second half is the same either way, and a second
// copy is what drifts.
const projectsIntroLead =
  PROJECTS_RIBBON === 'stack'
    ? 'The projects span consumer, enterprise, finance, and developer tooling. '
    : '';

// Non-breaking space inside a multi-word term, exactly as .impact-items does
// for "Campaign Building": the ` · ` separators are the only places this line
// may break, so a term never splits across two lines. Built from the array so
// the four terms are written once.
const domainsLine = PROJECT_DOMAINS.map((domain) => domain.replace(/ /g, '\u00a0')).join(' · ');

// The Mondrian About panel has finite room, so the list is capped and the
// "View all writing" link carries the remainder. Category + featured
// frontmatter keep this curated sequence in the collection rather than a
// hand-maintained array literal.
const WRITING_LIST_LIMIT = 5;

// Plain title text. The per-link trailing arrow (and the .no-break span that
// bound it to the final word) came off in #659: the arrow now marks only the
// two navigational exits out of the panel, so a title is just a title.
const writingLinks = editorialPosts.slice(0, WRITING_LIST_LIMIT).map((post) => ({
  href: `/blog/${post.id}/`,
  title: post.data.title,
}));

// NOW section — current-state signal under About. Content + freshness
// timestamp live in `src/content/bio/now.md`; the template only
// renders. See #272.
const nowEntry = await getEntry('bio', 'now');
if (!nowEntry) {
  throw new Error('Missing bio entry "now" — expected at src/content/bio/now.md');
}
const { Content: NowContent } = await render(nowEntry);

const homepageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://nathanpayne.com/#website",
      "url": "https://nathanpayne.com/",
      "name": "Nathan Payne",
      "description": "Product manager working with AI coding agents and platform products. Previously led product work for the device platform behind Disney+, Hulu, and ESPN.",
      "publisher": {
        "@id": "https://nathanpayne.com/#person"
      }
    },
    {
      "@type": "ProfilePage",
      "@id": "https://nathanpayne.com/#webpage",
      "url": "https://nathanpayne.com/",
      "name": "Nathan Payne | Product Manager · AI Agents · San Francisco",
      "description": "Product manager working with AI coding agents and platform products. Previously led product work for the device platform behind Disney+, Hulu, and ESPN.",
      "isPartOf": {
        "@id": "https://nathanpayne.com/#website"
      },
      "mainEntity": {
        "@id": "https://nathanpayne.com/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "https://nathanpayne.com/#person",
      "name": "Nathan Payne",
      "url": "https://nathanpayne.com/",
      "description": "Nathan Payne is a product manager working at the intersection of AI coding agents and shipped software.",
      "alumniOf": {
        "@type": "Organization",
        "name": "The Walt Disney Company"
      },
      "homeLocation": {
        "@type": "Place",
        "name": "San Francisco, California, United States"
      },
      "sameAs": [
        "https://www.linkedin.com/in/nathanpayne/",
        "https://github.com/nathanjohnpayne",
        "https://bsky.app/profile/nathanpayne.bsky.social",
        "https://www.instagram.com/nathanpayne/",
        "https://www.threads.com/@nathanpayne",
        "https://x.com/nathanpayne"
      ]
    }
  ]
};
---

<BaseLayout
  title="Nathan Payne | Product Manager · AI Agents · San Francisco"
  description="Product manager working with AI coding agents and platform products. Previously led product work for the device platform behind Disney+, Hulu, and ESPN."
  dataPalette="1930"
  jsonLd={homepageJsonLd}
>
  <main class="stage">
    <section class="mondrian" id="mondrian" aria-label="Interactive portfolio sections">
      <article class="panel panel--red" data-panel="about" data-label="Nathan Payne" role="region" aria-label="About Nathan Payne">
        <div class="panel-label panel-label--name" tabindex="0" role="button" aria-label="Open Nathan Payne section"><span>Nathan Payne</span></div>
        <div class="panel-content">
          <div class="content-inner">
            <h1>Nathan Payne</h1>
            <p class="lead">Most product decisions are invisible—until they aren’t.</p>
            <div class="about-blocks">
              <div class="about-block">
                <span class="eyebrow about-label">Context</span>
                <p>Over the past ten years, I worked on the streaming platforms behind Disney+, Hulu, and ESPN. I started at MLB.com and BAMTECH, joined Disney through the 2017 acquisition, and spent the last five years leading the Native Client Platform across PlayStation, Xbox, Amazon Fire TV, Linux set-top boxes, and smart TVs.</p>
              </div>
              <div class="about-block">
                <span class="eyebrow about-label">Approach</span>
                <p>The work that interests me is usually hiding at a boundary—between systems, between sources of truth, or between what a product claims and what it can actually prove. A codec mismatch, an ambiguous financial rule, and an AI agent that knows a policy but doesn’t follow it are versions of the same product problem: uncertainty that somebody eventually has to resolve. I like turning that ambiguity into something explicit enough to design, test, and operate.</p>
              </div>
              {/* NOW absorbed the former RÉSUMÉ section in #659. Its opening
                  line ("Open to new platform & product roles") restated the
                  "Open to senior product and platform roles" already two
                  paragraphs above it, so only the link survived the fold.
                  .about-now-flow exists so the link joins the end of NOW's
                  last sentence instead of standing as its own line — see the
                  display rule in global.css. The anchor stays in the template
                  rather than in src/content/bio/now.md: that file is prose,
                  and no content markdown in this repo carries markup. */}
              <div class="about-block about-block--now">
                <span class="eyebrow about-label">Now</span>
                <div class="about-now-flow">
                  <NowContent />
                  <a href="/resume/" class="p-name-link about-resume-link">Read my <span class="no-break">résumé<span class="link-arrow" aria-hidden="true">→</span></span></a>
                </div>
              </div>
              <div class="about-block about-block--writing">
                <span class="eyebrow about-label">Writing</span>
                <p>Selected writing on shipping software with AI coding agents—scope, review, and the decisions that don’t show up in the diff.</p>
                {/* .writing-list wraps the post list alone. It also held the
                    exit link until #975, so that the two read as one block
                    (#659); the exit now sits on the ribbon below with every
                    other panel's, which is the same idea carried further —
                    one voice for "leaves this panel", in one place. Keeping
                    it here would also keep it inside the .writing-list a
                    selector that captures article clicks. */}
                <div class="writing-list">
                  <ul class="writing-list__posts">
                    {writingLinks.map((link) => (
                      <li><a href={link.href} class="p-name-link writing-link">{link.title}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="now-ribbon">
                <div class="ribbon-row">
                  <span class="eyebrow now-ribbon-label">Last updated</span>
                  <a href="/blog/" class="ribbon-exit">View all writing<span class="link-arrow" aria-hidden="true">→</span></a>
                </div>
                <span class="now-ribbon-date">{nowEntry.data.lastUpdated}</span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <div class="block block--white-a" aria-hidden="true"></div>

      <article class="panel panel--yellow" data-panel="projects" data-label="Projects" role="region" aria-label="Personal projects">
        <div class="panel-label" tabindex="0" role="button" aria-label="Open Projects section">Projects</div>
        <div class="panel-content">
          <div class="content-inner">
            <h2>Selected Projects</h2>
            <p>{projectsIntroLead}The case studies focus on the decisions, tradeoffs, and evidence behind them; I built each with AI agents under a review system I designed.</p>
            {/* Builds grid — hand-authored, NOT generated from the projects
                collection, so the `order` field on the project source files has
                no effect here. This is a *selected* set: the heading says so, and
                a project may be omitted here while still appearing on /projects/.
                What must hold is the relative order — whatever subset is listed
                follows the canonical sequence in specs/project-pages.md
                § Canonical project ordering. Lifecycle labels are looked up from
                frontmatter rather than typed, so only the sequence is by hand.
                Guarded by tests/homepage-writing.test.js (#892). */}
            <div class="project-list">
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/five-across/" aria-label="Read the Five Across project page">Five Across<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('five-across')}>{statusOf('five-across')}</span>
                </div>
                <p>A multiplayer bingo game built for a nine-night cruise, with daily themed cards, offline-first marking, live standings, and a choreographed finale.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/mergepath/" aria-label="Read the Mergepath project page">Mergepath<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('mergepath')}>{statusOf('mergepath')}</span>
                </div>
                <p>A repository standard for the gap between what a fleet of AI coding agents can produce and what one operator can responsibly stand behind.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/override/" aria-label="Read the Override project page">Override<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('override')}>{statusOf('override')}</span>
                </div>
                <p>A financial operating system for Broadway productions—models capitalization and investor returns, manages ownership, and shares a read-only deal room with backers instead of spreadsheet and PDF workflows.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/device-source-of-truth/" aria-label="Read the Device Source of Truth project page">Device Source of Truth<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('device-source-of-truth')}>{statusOf('device-source-of-truth')}</span>
                </div>
                <p>A single web application that tracks partner-device hardware, DRM, codec support, and operational readiness—unifying fragmented device data while keeping consequential changes behind human review.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/matchline/" aria-label="Read the Matchline project page">Matchline<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('matchline')}>{statusOf('matchline')}</span>
                </div>
                <p>A career CRM for one person running a serious job search—turns work history into approved evidence, maps it against a specific job&rsquo;s requirements, and blocks the export when a claim doesn&rsquo;t trace back.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/swipe-watch/" aria-label="Read the Swipe Watch project page">Swipe Watch<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('swipe-watch')}>{statusOf('swipe-watch')}</span>
                </div>
                <p>A swipe-based discovery experiment for Disney+ and Hulu that turns expressing taste into a game—built in vanilla JS across three days of one week.</p>
              </div>
              <div class="project-item">
                <div class="p-head">
                  <a class="p-name p-name-link" href="/projects/friends-and-family-billing/" aria-label="Read the Friends and Family Billing project page">Friends &amp; Family Billing<span class="link-arrow" aria-hidden="true">→</span></a>
                  <span class={statusClass('friends-and-family-billing')}>{statusOf('friends-and-family-billing')}</span>
                </div>
                <p>Shared billing for recurring household costs—showing recipients the arithmetic, tracking settlement, and handling questions without requiring an account.</p>
              </div>
            </div>
            {/* The footer's content line, DOMAINS or STACK (#984). Every other
                panel footer ends on a bounded line — four scope terms in
                Community, one title in Connect, one date in About — and this one
                ended on ten stack items that ran the full measure and under the
                exit link. DOMAINS is bounded by what it names and is the sentence
                a product screen should retain; the stack still appears on every
                project page and on the résumé. The switch is temporary and is
                meant to be deleted once one of the two has been lived with; see
                src/lib/projects-ribbon.ts.

                The index link moved onto this eyebrow row from a bordered
                .nav-button above the ribbon (#892); every panel exit now sits on
                its footer's eyebrow row. The button was added to make the index
                an obvious destination and did not: over 90 days /projects/ took
                1 of its 82 views from this page. Wayfinding, at wayfinding
                weight.

                Under 'stack': rendered from the ladder array, not typed out, so
                the rungs cannot drift apart. The map output must stay
                whitespace-free on one line — the ` · ` separators are ::before
                pseudo-elements, and markup whitespace between the spans would
                double the space before each one. #930. */}
            {PROJECTS_RIBBON === 'domains' ? (
              <div class="domains-ribbon">
                <div class="ribbon-row">
                  <span class="eyebrow domains-label">Domains</span>
                  <a href="/projects/" class="ribbon-exit">View all projects<span class="link-arrow" aria-hidden="true">→</span></a>
                </div>
                <span class="domains-items">{domainsLine}</span>
              </div>
            ) : (
              <div class="stack-ribbon">
                <div class="ribbon-row">
                  <span class="eyebrow stack-label">Stack</span>
                  <a href="/projects/" class="ribbon-exit">View all projects<span class="link-arrow" aria-hidden="true">→</span></a>
                </div>
                <span class="stack-items">{cappedStackLadder.map((item) => <span class="stack-item" data-stack-tier={item.tier}>{item.label}</span>)}</span>
              </div>
            )}
          </div>
        </div>
      </article>

      <div class="block block--white-b" aria-hidden="true"></div>

      <article class="panel panel--black" data-panel="community" data-label="Community" role="region" aria-label="Community organizing and fundraising">
        <div class="panel-label" tabindex="0" role="button" aria-label="Open Community section">
          <span class="panel-label__h" data-label-orientation="horizontal">Community</span>
          <span class="panel-label__v" data-label-orientation="vertical" aria-hidden="true">Community</span>
        </div>
        <div class="panel-content">
          <div class="content-inner">
            <h2>Giving &amp; Governing</h2>
            <p>Outside work, I’ve spent years organizing around causes I care about—raising more than $105,000, building campaigns, and staying involved after the fundraising ended.</p>
            <ul class="effort-list">
              <li>
                <a class="effort-link" href="https://donate.larkinstreetyouth.org/campaign/653966/donate" target="_blank" rel="noopener">Larkin Street Youth Services<span class="link-arrow" aria-hidden="true">→</span></a>
                <div class="effort-amount">$16,684 raised</div>
                <div class="effort-desc">Raised for Safe &amp; Seen, a campaign for LGBTQ+ youth experiencing homelessness in San Francisco, supporting housing, education, and healthcare through Larkin Street Youth Services.</div>
              </li>
              <li>
                <a class="effort-link" href="https://www.sfaf.org" target="_blank" rel="noopener">San Francisco AIDS Foundation<span class="link-arrow" aria-hidden="true">→</span></a>
                <div class="effort-amount">$80,195 raised</div>
                <div class="effort-desc">Three AIDS/LifeCycle rides: $9,166 in 2023, $45,646 in 2024, and $25,383 in 2025, supporting HIV prevention, care services, and housing stability through the San Francisco AIDS Foundation.</div>
              </li>
              <li>
                <a class="effort-link" href="https://jewishfed.org/what-we-do/our-programs/giving-circles/jewish-pride-fund/" target="_blank" rel="noopener">Jewish Pride Fund<span class="link-arrow" aria-hidden="true">→</span></a>
                <div class="effort-amount">$8,959 raised</div>
                <div class="effort-desc">After the campaign, I joined one of the country’s few LGBTQ+ Jewish giving circles to interview grant applicants and help decide where its grants go.</div>
              </li>
            </ul>
            <div class="impact-ribbon">
              <span class="eyebrow impact-label">Scope</span>
              <span class="impact-items">Fundraising · Campaign&nbsp;Building · Grantmaking · Community&nbsp;Organizing</span>
            </div>
          </div>
        </div>
      </article>

      <div class="block block--white-c" aria-hidden="true"></div>
      <div class="block block--gray-e" aria-hidden="true"></div>
      <div class="block block--gray-d" aria-hidden="true"></div>

      <article class="panel panel--blue" data-panel="connect" data-label="Connect" role="region" aria-label="Connect links">
        <div class="panel-label" tabindex="0" role="button" aria-label="Open Connect section">Connect</div>
        <div class="panel-content">
          <div class="content-inner">
            <h2>Connect</h2>
            {/* ── Availability signal ──────────────────────────────────
                 Contact affordances only. The line opened with "Open to new
                 roles and collaborations." until #969: availability is a
                 site-level fact, and the NOW paragraph above already states
                 it once, with the kind of role attached. The class name is
                 unchanged—analytics events and tests key off
                 `.availability-signal`, `#availability-mailto`, and
                 `.availability-booking` (specs/analytics.md).
                 The mailto address is assembled client-side from base64
                 fragments so the string `hire@nathanpayne.com` never
                 appears in the static HTML (protects against the simplest
                 scrapers). The <noscript> fallback is plain text for
                 JS-disabled users. The inline <script is:inline> runs
                 synchronously after the element is parsed, so the window
                 between page paint and href assembly is negligible. */}
            <p class="availability-signal">
              <a
                id="availability-mailto"
                class="availability-mailto p-link"
                href="#"
                data-u="aGlyZQ=="
                data-d="bmF0aGFucGF5bmUuY29t"
                data-s="RnJvbSUyMG5hdGhhbnBheW5lLmNvbQ=="
              >Get in touch<span class="link-arrow" aria-hidden="true">→</span></a>
              {' · '}
              {/* Scheduling link (#620). Unlike the mailto beside it this is a
                  plain href in the static HTML — there is no address to
                  harvest, so the base64 assembly would buy nothing and would
                  cost the JS-disabled case. Booking is spam-hardened on the
                  Cal.com side (booker email verification, guest invites
                  disabled, rolling window, daily/weekly caps, required
                  screening question) — see the audit on #620. */}
              <a
                class="availability-booking p-link"
                href="https://cal.com/nathanpayne"
                target="_blank"
                rel="noopener"
              >Book time<span class="link-arrow" aria-hidden="true">→</span></a>
              {' · '}
              <a class="availability-resume p-link" href="/resume/">Résumé<span class="link-arrow" aria-hidden="true">→</span></a>
            </p>
            <noscript>
              <p class="availability-noscript">Email: hire [at] nathanpayne [dot] com</p>
            </noscript>
            <script is:inline>
              (function () {
                const el = document.getElementById('availability-mailto');
                if (!el) return;
                try {
                  const user = atob(el.dataset.u);
                  const domain = atob(el.dataset.d);
                  const subject = el.dataset.s ? atob(el.dataset.s) : '';
                  el.href = 'mailto:' + user + '@' + domain + (subject ? '?subject=' + subject : '');
                } catch (_e) { /* leave href as "#" — noscript covers the fallback */ }
              })();
            </script>
            {/* Elsewhere is off-site only (#972). Blog and Résumé used to sit
                in this list, which made the label a lie: both are on this
                site, Résumé is already in the action row above, and the blog
                is reachable from the Writing panel and the Latest Post
                footer below. Only add a row here for a destination that
                leaves nathanpayne.com. */}
            <span class="eyebrow connect-label">Elsewhere</span>
            <div class="social-stack">
              <a href="https://www.linkedin.com/in/nathanpayne/" target="_blank" rel="noopener" class="social-row social-row--linkedin">
                <span class="s-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.03-1.85-3.03-1.86 0-2.14 1.45-2.14 2.94v5.66H9.35V9.01h3.41v1.56h.05c.47-.9 1.64-1.86 3.37-1.86 3.6 0 4.27 2.38 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9.01h3.56v11.44z"></path>
                  </svg>
                </span>
                <span class="s-label">LinkedIn</span>
                <span class="s-arrow">→</span>
              </a>
              <a href="https://github.com/nathanjohnpayne" target="_blank" rel="noopener" class="social-row social-row--github">
                <span class="s-icon" aria-hidden="true">
