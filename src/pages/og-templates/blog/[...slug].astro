---
import { getCollection } from 'astro:content';
import OgCard from '../../../layouts/OgCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => {
    const words = post.body?.split(/\s+/).length ?? 0;
    const minutes = Math.ceil(words / 225);
    const dateStr = post.data.date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    });
    const tags = post.data.tags.slice(0, 3).join(' · ');
    const metaParts = [dateStr, `${minutes} min read`, tags].filter(Boolean);
    return {
      params: { slug: post.id },
      props: {
        // Same source as <title> / og:title (#623): the social card and the
        // unfurl headline must agree. `seoTitle` is the canonical headline at
        // SERP length; `shortTitle` is a breadcrumb abbreviation and is
        // deliberately not used here.
        title: post.data.seoTitle?.trim() || post.data.title,
        meta: metaParts.join(' · '),
      },
    };
  });
}

const { title, meta } = Astro.props;
---

<OgCard
  label="nathanpayne.com / blog"
  heading={title}
  meta={meta}
/>
