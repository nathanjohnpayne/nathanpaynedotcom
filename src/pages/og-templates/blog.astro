---
import OgCard from '../../layouts/OgCard.astro';
import { getEntry } from 'astro:content';

const blogIndex = await getEntry('siteCopy', 'blog');
if (!blogIndex) {
  throw new Error('Missing blog page entry: src/content/site-copy/blog.md');
}
---

<OgCard
  label="nathanpayne.com / blog"
  heading={blogIndex.data.title}
  description={blogIndex.data.description}
/>
