---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Page Not Found | Nathan Payne"
  description="The page you're looking for doesn't exist. Navigate back to Nathan Payne's portfolio, blog, or projects."
  bodyClass="project-page"
  dataAccent="red"
  noindex
>
  <main class="error-shell">
    <div class="error-mondrian page-canvas">
      <div class="e-content">
        <Breadcrumbs items={[{ label: "Nathan Payne", href: "/" }, { label: "404" }]} />
        <h1>Page not found</h1>
        <p class="deck">The page you're looking for doesn't exist or has been moved.</p>
        <div class="project-actions">
          <a class="project-action" href="/">Homepage</a>
          <a class="project-action" href="/resume/">Résumé</a>
          <a class="project-action" href="/projects/">Builds</a>
          <a class="project-action" href="/blog/">Blog</a>
        </div>
      </div>

      {/* Decorative Mondrian blocks */}
      <div class="e-block e-red" aria-hidden="true"></div>
      <div class="e-block e-yellow-a" aria-hidden="true"></div>
      <div class="e-block e-blue" aria-hidden="true"></div>
      <div class="e-block e-black" aria-hidden="true"></div>
      <div class="e-block e-white-a" aria-hidden="true"></div>
      <div class="e-block e-white-b" aria-hidden="true"></div>
      <div class="e-block e-yellow-b" aria-hidden="true"></div>
      <div class="e-block e-white-c" aria-hidden="true"></div>
    </div>
  </main>
</BaseLayout>
