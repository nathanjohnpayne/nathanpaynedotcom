---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
// #1079: the 404 has no shared footer, so it carries the /privacy/ link
// itself; the component renders nothing while the privacy flag is off.
import PrivacyLink from '../components/privacy/ui/PrivacyLink.astro';
import NavIcon from '../components/NavIcon.astro';
// #1494: the /how-i-write/ link sits just before Privacy, as in the footer.
import HowIWriteLink from '../components/HowIWriteLink.astro';
---

<BaseLayout
  title="Page Not Found | Nathan Payne"
  description="The page you're looking for doesn't exist. Navigate back to Nathan Payne's portfolio, blog, or projects."
  bodyClass="project-page"
  dataAccent="red"
  noindex
>
  <main class="error-shell">
    <div class="error-mondrian page-canvas">
      <div class="e-content">
        <Breadcrumbs items={[{ label: "Nathan Payne", href: "/" }, { label: "404" }]} />
        <h1>Page not found</h1>
        <p class="deck">The page you're looking for doesn't exist or has been moved.</p>
        {/*
          Canonical wayfinding labels (see #524): these match the navigation
          labels used elsewhere — "Projects" (homepage panel + project index
          breadcrumb) and "Blog" (homepage social row + blog breadcrumb). They
          intentionally differ from the editorial H1s ("Products—and the
          decisions behind them",
          "The AI-Augmented PM"). Guarded by tests/nav-labels.test.js.
        */}
        {/*
          Eight destinations in two rows of four above 480px (owner decision,
          #1494): the four content sections, then Book, Brand and the two
          policy pages. At <=480 they stack full width as before.
        */}
        <div class="project-actions e-actions">
          <a class="nav-button" href="/"><NavIcon name="house" />Homepage</a>
          <a class="nav-button" href="/resume/"><NavIcon name="file-user" />Résumé</a>
          <a class="nav-button" href="/projects/"><NavIcon name="layout-grid" />Projects</a>
          <a class="nav-button" href="/blog/"><NavIcon name="newspaper" />Blog</a>
          <a class="nav-button" href="/book/"><NavIcon name="calendar" />Book</a>
          <a class="nav-button" href="/brand/"><NavIcon name="palette" />Brand</a>
          <HowIWriteLink class="nav-button" icon="label" source="404" />
          <PrivacyLink class="nav-button" icon="label" />
        </div>
      </div>

      {/* Decorative Mondrian blocks */}
      <div class="e-block e-red" aria-hidden="true"></div>
      <div class="e-block e-yellow-a" aria-hidden="true"></div>
      <div class="e-block e-blue" aria-hidden="true"></div>
      <div class="e-block e-black" aria-hidden="true"></div>
      <div class="e-block e-white-a" aria-hidden="true"></div>
      <div class="e-block e-white-b" aria-hidden="true"></div>
      <div class="e-block e-yellow-b" aria-hidden="true"></div>
      <div class="e-block e-white-c" aria-hidden="true"></div>
    </div>
  </main>
</BaseLayout>
