---
/**
 * /resume — Nathan Payne's resume, rendered as native content from the
 * resume content collections (see src/content.config.ts) and small section
 * components (src/components/resume/). Laid out in the blog-post reading
 * format — a Mondrian "composition with margins" canvas (accent margin ▏
 * content ▏ sticky sidebar with a metadata panel + in-page ToC) — mirroring
 * src/layouts/BlogPost.astro via parallel .resume-canvas-* classes. Prints to
 * a clean two-page PDF (margin/sidebar hidden) via the @media print rules in
 * global.css. See #394 / #402 and specs/resume.md.
 */
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SummarySection from '../components/resume/SummarySection.astro';
import SkillsSection from '../components/resume/SkillsSection.astro';
import ExperienceSection from '../components/resume/ExperienceSection.astro';
import EducationSection from '../components/resume/EducationSection.astro';
import CertificationsSection from '../components/resume/CertificationsSection.astro';
import ProjectsSection from '../components/resume/ProjectsSection.astro';
import ContactIcon from '../components/resume/ContactIcon.astro';
import WritingSection from '../components/resume/WritingSection.astro';
// Single source of truth for the built PDF's path — the same constant the
// build-time generator writes to, so the link can never point at a filename
// that isn't produced (#616).
import { RESUME_PDF_PATH } from '../integrations/resume-pdf.mjs';
import { getSiteCopy } from '../lib/site-copy';
import { alumniOf, shortLocation } from '../lib/person-json-ld';

const myself = await getEntry('myself', 'nathan-payne');
if (!myself) {
  throw new Error('Missing myself entry "nathan-payne" — expected at src/content/myself/nathan-payne.md');
}
const m = myself.data;
const location = shortLocation(m.address);

const [skills, experience, education, certifications, resumeProjects] = await Promise.all([
  getCollection('skills'),
  getCollection('experience'),
  getCollection('education'),
  getCollection('certifications'),
  getCollection('resumeProjects'),
]);

// Header contact links. Social handles are stored bare in the collection;
// the full URL is composed here. Profile links are absolute (it's a CV
// contact block) so the print stylesheet can append the URL after the text.
const profileLinks = [
  { display: m.website, href: `https://${m.website}`, icon: 'globe' },
  { display: `linkedin.com/in/${m.linkedin}`, href: `https://linkedin.com/in/${m.linkedin}`, icon: 'linkedin' },
  { display: `github.com/${m.github}`, href: `https://github.com/${m.github}`, icon: 'github' },
] as const;

// Contact-action targets, shared by the header action row (#703) and the
// end-of-page availability CTA (#702) so the two can never drift apart.
// Both are plain hrefs in the static HTML, deliberately unlike the
// base64-assembled mailto on the homepage and in blog posts: the header
// contact block already publishes the address for print. In production,
// Cloudflare Scrape Shield obfuscates the three mail links and the visible
// address,
// restoring them with JavaScript. Issue #710 accepts that no-JS tradeoff to
// keep zone-wide email obfuscation enabled; the PDF and JSON-LD still carry
// the address. Booking carries no address to harvest and is spam-hardened on
// the Cal.com side (see the audit on #620).
const contactMailto = `mailto:${m.email}?subject=${encodeURIComponent('From nathanpayne.com/resume')}`;
const bookingUrl = 'https://cal.com/nathanpayne';

// Sidebar "In this resume" ToC. The page is component-composed (no single
// markdown body), so there are no render() headings to derive from — the ToC
// is built from the static section list. The dormant awards scaffold is added
// here only when the first real entry is wired up (#654).
const toc = [
  { label: 'Summary', id: 'summary' },
  { label: 'Skills', id: 'skills' },
  { label: 'Experience', id: 'experience' },
  { label: 'Education', id: 'education' },
  { label: 'Certifications', id: 'certifications' },
  { label: 'Projects', id: 'projects' },
  { label: 'Writing', id: 'writing' },
];

// Sidebar highlight cards — marquee metrics, each authored as a named
// `highlights` field on the experience entry it condenses (#1166), so the card
// sits beside the role it summarizes rather than in this template. This list
// owns only which cards show and in what order; accents cycle red/yellow/blue.
// A missing entry or key fails the build rather than dropping a card.
const HIGHLIGHT_SELECTION = [
  ['disney-ncp', 'ncpv3'],
  ['disney-ncp', 'vega-os'],
  ['disney-ncp', 'pr-review-pipeline'],
  ['disney-ncp', 'device-intelligence'],
  ['cnn', 'magic-wall'],
] as const;
const HIGHLIGHT_ACCENTS = ['red', 'yellow', 'blue'] as const;
const highlights = HIGHLIGHT_SELECTION.map(([entryId, key], i) => {
  const text = experience.find((entry) => entry.id === entryId)?.data.highlights?.[key];
  if (!text) {
    throw new Error(
      `Résumé highlight "${entryId}/${key}" not found: add highlights.${key} to src/content/experience/${entryId}.md or drop it from HIGHLIGHT_SELECTION`,
    );
  }
  return { text, accent: HIGHLIGHT_ACCENTS[i % HIGHLIGHT_ACCENTS.length] };
});

// At-a-glance metadata topics (screen-only panel; contact stays in the
// header so it prints).
const topics = ['Connected-TV', 'Device certification', 'Subscription activation', 'Partner ecosystems', 'Observability', 'AI-augmented dev', 'Developer tools'];

const title = 'Nathan Payne | Résumé';
// Dedicated one-line meta/OG/JSON-LD description (≤ ~160 chars) — the on-page
// summary is a paragraph, too long for a social card. The résumé share card
// (og-templates/resume.astro) reads the same field (#1166).
const { description } = await getSiteCopy('resume');

const canonical = new URL('/resume/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': 'https://nathanpayne.com/#website' },
      mainEntity: { '@id': 'https://nathanpayne.com/#person' },
    },
    {
      '@type': 'Person',
      '@id': 'https://nathanpayne.com/#person',
      name: m.name,
      jobTitle: m.title,
      url: 'https://nathanpayne.com/',
      email: `mailto:${m.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: m.address.locality,
        addressRegion: m.address.region,
        addressCountry: m.address.country,
      },
      sameAs: [
        `https://linkedin.com/in/${m.linkedin}`,
        `https://github.com/${m.github}`,
      ],
      alumniOf: alumniOf(education, experience),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://nathanpayne.com/og/resume.png"
  ogImageAlt="Nathan Payne—Résumé"
  bodyClass="resume-page"
  dataAccent="red"
  jsonLd={jsonLd}
>
  <main class="resume-shell">
    {/* ── Mondrian "composition with margins" canvas ──────────────
         3-column grid: accent margin | content | sidebar. The --ink
         background shows through the var(--line) gaps as grid lines.
         Mirrors src/layouts/BlogPost.astro. ─────────────────────── */}
    <article class="resume-canvas page-canvas">

      {/* Left margin: per-row Mondrian accent blocks (decorative) */}
      <div class="resume-canvas-margin resume-canvas-margin--header" aria-hidden="true"></div>
      <div class="resume-canvas-margin resume-canvas-margin--body" aria-hidden="true"></div>
      <div class="resume-canvas-margin resume-canvas-margin--footer" aria-hidden="true"></div>

      {/* Header — breadcrumbs, name, title, and contact (kept here so it prints) */}
      <header class="resume-canvas-header">
        <Breadcrumbs
          items={[
            { label: "Nathan Payne", href: "/" },
            { label: "Résumé" },
          ]}
        />
        <h1 class="resume-name">{m.name}</h1>
        <p class="resume-title">{m.title}</p>
        <p class="resume-contact resume-contact--primary">
          <span class="resume-contact__location"><ContactIcon name="mappin" />{location}</span>
          <span class="resume-contact__sep" aria-hidden="true">·</span>
          <a href={`mailto:${m.email}`}><ContactIcon name="mail" />{m.email}</a>
        </p>
        <p class="resume-contact resume-contact--profiles">
          {profileLinks.map((link, i) => (
            <>
              {i > 0 && <span class="resume-contact__sep" aria-hidden="true">·</span>}
              <a href={link.href} target="_blank" rel="noopener"><ContactIcon name={link.icon} />{link.display}</a>
            </>
          ))}
        </p>
        {/* Header actions (#616, #703). Download PDF points at the letter-size
            PDF that src/integrations/resume-pdf.mjs renders from this page's
            own @media print cascade at build time, so the file cannot drift
            from what's on screen; the two sibling actions reuse the shared
            targets declared above. The whole container is screen-only:
            @media print hides .resume-actions, so none of the three reaches
            the generated PDF, where an action button is meaningless on
            paper. */}
        <p class="resume-actions">
          <a class="resume-action resume-download" href={RESUME_PDF_PATH} download data-resume-action="download">
            <ContactIcon name="download" />Download PDF
          </a>
          <a
            class="resume-action"
            href={contactMailto}
            data-resume-action="email"
          >
            <ContactIcon name="mail" />Get in touch
          </a>
          <a
            class="resume-action"
            href={bookingUrl}
            target="_blank"
            rel="noopener"
            data-resume-action="schedule"
          >
            <ContactIcon name="calendar" />Book a time
          </a>
        </p>
      </header>

      {/* Metadata panel (top-right; screen-only — contact lives in the header) */}
      <div class="resume-canvas-meta">
        <dl>
          <div><dt>Location</dt><dd>{location}</dd></div>
          <div><dt>Availability</dt><dd>{m.availability.long}</dd></div>
          <div><dt>Focus</dt><dd>Platform · Streaming · AI-augmented development</dd></div>
          <div>
            <dt>Topics</dt>
            <dd class="resume-canvas-topics">
              {topics.map((topic) => (
                <span class="resume-canvas-topic">{topic}</span>
              ))}
            </dd>
          </div>
        </dl>
      </div>

      {/* Main content column */}
      <div class="resume-canvas-content">
        <SummarySection entry={myself} />
        <SkillsSection categories={skills} />
        <ExperienceSection entries={experience} />
        <EducationSection entries={education} />
        <CertificationsSection entries={certifications} />
        <ProjectsSection entries={resumeProjects} />
        <WritingSection />

        {/* Availability CTA (#702). Takes its shape from the end-of-post
            block in src/layouts/BlogPost.astro, minus its Résumé link — the
            reader is already on the résumé. The two ledes diverged in #969:
            that block carries a byline now, because an availability line
            after an essay reads as a pitch; here the reader came for exactly
            that fact, so it stays. Kept on the parallel .resume-cta namespace
            rather than reusing .blog-cta, per specs/resume.md § Styling: the
            resume must not move when the blog layout does. Screen-only —
            @media print hides it, so it stays out of the generated PDF. */}
        <aside class="resume-cta" aria-label="Availability">
          <p class="resume-cta__line">
            <span class="resume-cta__lede">{m.availability.short}</span>
            <a
              class="resume-cta__link"
              href={contactMailto}
              data-resume-cta="email"
              >Get in touch<span class="link-arrow" aria-hidden="true">→</span></a
            >
            <span class="resume-cta__sep" aria-hidden="true">·</span>
            <a
              class="resume-cta__link"
              href={bookingUrl}
              target="_blank"
              rel="noopener"
              data-resume-cta="schedule"
              >Book a time<span class="link-arrow" aria-hidden="true">→</span></a
            >
          </p>
        </aside>
      </div>

      {/* Right sidebar — in-page ToC + highlight cards (screen-only) */}
      <aside class="resume-canvas-sidebar" aria-label="Résumé sidebar">
        <div class="resume-canvas-sidebar-inner">
          <nav class="resume-canvas-section resume-canvas-toc" aria-label="Table of contents">
            <h2 class="resume-canvas-heading">In this résumé</h2>
            <ol class="resume-canvas-toc-list">
              {toc.map((item) => (
                <li><a href={`#${item.id}`}>{item.label}</a></li>
              ))}
            </ol>
          </nav>
          <div class="resume-canvas-section resume-canvas-highlights">
            <h2 class="resume-canvas-heading">Highlights</h2>
            {highlights.map((highlight) => (
              <blockquote class={`resume-highlight resume-highlight--${highlight.accent}`}>
                <p>{highlight.text}</p>
              </blockquote>
            ))}
          </div>
        </div>
      </aside>

      {/* Footer */}
      <Footer
        attribution={m.name}
        variant="canvas"
        class="site-footer--resume"
        links={[
          { href: "/", label: "← Back to Homepage" },
          { href: "/blog/", label: "Read the Blog →" },
        ]}
      />

    </article>
  </main>

  <script is:inline>
    window.posthog?.capture('resume_viewed');
    // Header actions (#616, #703). The PDF download keeps its own dedicated
    // event name — it predates the row and existing PostHog insights key off
    // it — while email/booking share a `resume_action_clicked` capture
    // discriminated by `action`.
    document.querySelectorAll('[data-resume-action]').forEach(function (link) {
      link.addEventListener('click', function () {
        const action = link.dataset.resumeAction;
        if (action === 'download') {
          window.posthog?.capture('resume_pdf_downloaded');
          return;
        }
        window.posthog?.capture('resume_action_clicked', { action: action });
      });
    });
    // End-of-page availability CTA (#702). A separate event from the header
    // row: reaching the bottom of the résumé is a different signal from
    // acting on the letterhead.
    document.querySelectorAll('[data-resume-cta]').forEach(function (link) {
      link.addEventListener('click', function () {
        window.posthog?.capture('resume_cta_clicked', { cta: link.dataset.resumeCta });
      });
    });
  </script>
</BaseLayout>
