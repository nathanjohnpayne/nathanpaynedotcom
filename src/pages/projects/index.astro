---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://nathanpayne.com/projects/#webpage",
      "url": "https://nathanpayne.com/projects/",
      "name": "Projects | Nathan Payne",
      "description": "AI-built products from a product manager—each one a real problem turned into a systems design exercise.",
      "isPartOf": { "@id": "https://nathanpayne.com/#website" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://nathanpayne.com/projects/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Nathan Payne", "item": "https://nathanpayne.com/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://nathanpayne.com/projects/" },
      ],
    },
  ],
};
---

<BaseLayout
  title="Projects | Nathan Payne"
  description="AI-built products from a product manager—each one a real problem turned into a systems design exercise."
  ogImage="https://nathanpayne.com/og/projects.png"
  ogImageAlt="Projects index open graph image"
  bodyClass="project-page project-page--yellow blog-page"
  jsonLd={jsonLd}
>
  <main class="shell">
    <div class="frame">

      {/* ── Hero ── */}
      <header class="hero">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Nathan Payne</a>
          <span class="breadcrumb-sep">/</span>
          <span>Projects</span>
        </nav>
        <p class="kicker">AI &times; Product &times; Engineering</p>
        <h1>Projects</h1>
        <p class="deck">Every project started as a real problem. Each one became a systems design exercise&mdash;built with AI agents from first commit to deploy.</p>
      </header>

      {/* ── Project Grid ── */}
      <div class="blog-grid">

        {/* Row 1: Featured project | Red | Blue */}
        <div class="grid-row--1">
          <article class="post-card">
            <p class="post-meta">{projects[0].data.tags.join(' · ')}</p>
            <h2 class="post-title"><a href={`/projects/${projects[0].data.slug}/`}>{projects[0].data.title}</a></h2>
            <p class="post-desc">{projects[0].data.description}</p>
            <div class="tag-row">
              <a href={projects[0].data.liveUrl} target="_blank" rel="noopener" class="tag">Live &nearr;</a>
            </div>
          </article>
          <div class="accent-red" aria-hidden="true"></div>
          <div class="accent-blue" aria-hidden="true"></div>
        </div>

        {/* Row 2: Project 2 | Yellow */}
        <div class="grid-row--2">
          <article class="post-card">
            <p class="post-meta">{projects[1].data.tags.join(' · ')}</p>
            <h2 class="post-title"><a href={`/projects/${projects[1].data.slug}/`}>{projects[1].data.title}</a></h2>
            <p class="post-desc">{projects[1].data.description}</p>
            <div class="tag-row">
              <a href={projects[1].data.liveUrl} target="_blank" rel="noopener" class="tag">Live &nearr;</a>
            </div>
          </article>
          <div class="accent-yellow" aria-hidden="true"></div>
        </div>

        {/* Row 3: Project 3 | Cream */}
        <div class="grid-row--3">
          <article class="post-card">
            <p class="post-meta">{projects[2].data.tags.join(' · ')}</p>
            <h2 class="post-title"><a href={`/projects/${projects[2].data.slug}/`}>{projects[2].data.title}</a></h2>
            <p class="post-desc">{projects[2].data.description}</p>
            <div class="tag-row">
              <a href={projects[2].data.liveUrl} target="_blank" rel="noopener" class="tag">Live &nearr;</a>
            </div>
          </article>
          <div class="accent-white" aria-hidden="true"></div>
        </div>

        {/* Row 4: Project 4 | Black | Paper */}
        <div class="grid-row--4">
          <article class="post-card">
            <p class="post-meta">{projects[3].data.tags.join(' · ')}</p>
            <h2 class="post-title"><a href={`/projects/${projects[3].data.slug}/`}>{projects[3].data.title}</a></h2>
            <p class="post-desc">{projects[3].data.description}</p>
            <div class="tag-row">
              <a href={projects[3].data.liveUrl} target="_blank" rel="noopener" class="tag">Live &nearr;</a>
            </div>
          </article>
          <div class="accent-black" aria-hidden="true"></div>
          <div class="accent-paper" aria-hidden="true"></div>
        </div>

      </div>

      {/* ── Footer ── */}
      <footer class="grid-footer">
        <span class="footer-attribution">Nathan Payne &middot; San Francisco</span>
        <a href="/" class="footer-action">&larr; Back to Homepage</a>
      </footer>
    </div>
  </main>
</BaseLayout>
