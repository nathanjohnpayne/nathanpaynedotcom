---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getIndexGridRow } from '../../lib/index-grid';
import { stateMarkerClass } from '../../lib/lifecycle-marker';

const PROJECTS_TITLE = 'Projects';
const PROJECTS_PAGE_TITLE = `${PROJECTS_TITLE} | Nathan Payne`;
const PROJECTS_HEADING = 'Products—and the decisions behind them';
const PROJECTS_DESCRIPTION_SUFFIX =
  'built end to end—the problem each one started as, what got built, what got refused, and what the evidence said afterward.';
const PROJECTS_OG_DESCRIPTION =
  'The problem each one started as, what got built, what got refused, and what the evidence said afterward.';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Lifecycle marker on the status kicker. Same primitive the homepage, the
// detail-page STATUS cell, and the decision ledgers use, so a reader who learns
// the vocabulary on one surface carries it to the others (#892). Position and
// type are unchanged — the kicker gains a mark, nothing else. The status → mark
// mapping lives in src/lib/lifecycle-marker.ts.
const statusClass = (status: string) =>
  stateMarkerClass(status, 'post-meta', 'project-status');
// Spelled out because it reads mid-sentence in the meta description and the
// CollectionPage JSON-LD below. Falls back to the numeral above nine, which the
// portfolio is nowhere near and would be a pleasant problem to have.
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const asWord = (n: number) => NUMBER_WORDS[n] ?? String(n);
// Derived rather than written, because a hand-typed count is wrong the first
// time a project is added or drafted and nothing catches it — the failure mode
// this epic spent #885 correcting on the Matchline page.
const totalWord = asWord(projects.length);
// Meta description and CollectionPage JSON-LD share the deck's derived count,
// so a drafted or added project cannot leave a stale number on a search surface
// while the visible page is correct.
const PROJECTS_DESCRIPTION = `${totalWord.charAt(0).toUpperCase()}${totalWord.slice(1)} products a product manager ${PROJECTS_DESCRIPTION_SUFFIX}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://nathanpayne.com/projects/#webpage",
      "url": "https://nathanpayne.com/projects/",
      "name": PROJECTS_PAGE_TITLE,
      "description": PROJECTS_DESCRIPTION,
      "isPartOf": { "@id": "https://nathanpayne.com/#website" },
      "mainEntity": { "@id": "https://nathanpayne.com/projects/#itemlist" },
    },
    {
      "@type": "ItemList",
      "@id": "https://nathanpayne.com/projects/#itemlist",
      "name": PROJECTS_HEADING,
      "itemListElement": projects.map((project, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "WebPage",
          "@id": `https://nathanpayne.com/projects/${project.data.slug}/`,
          "url": `https://nathanpayne.com/projects/${project.data.slug}/`,
          "name": project.data.title,
          "description": project.data.seoDescription || project.data.description,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://nathanpayne.com/projects/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Nathan Payne", "item": "https://nathanpayne.com/" },
        { "@type": "ListItem", "position": 2, "name": PROJECTS_TITLE, "item": "https://nathanpayne.com/projects/" },
      ],
    },
  ],
};
---

<BaseLayout
  title={PROJECTS_PAGE_TITLE}
  description={PROJECTS_DESCRIPTION}
  ogDescription={PROJECTS_OG_DESCRIPTION}
  ogImage="https://nathanpayne.com/og/projects.png"
  ogImageAlt={`${PROJECTS_HEADING} projects index open graph image`}
  bodyClass="project-page blog-page"
  dataAccent="yellow"
  jsonLd={jsonLd}
>
  <main class="shell">
    <div class="frame page-canvas">

      {/* ── Hero ── */}
      <header class="hero">
        <Breadcrumbs items={[{ label: "Nathan Payne", href: "/" }, { label: PROJECTS_TITLE }]} />
        <h1>{PROJECTS_HEADING}</h1>
        <p class="deck">Every one of these began as a real problem&mdash;mine, or one I watched up close. The decisions are the part worth reading: what got built, what got refused, and what the evidence said once it was running. Each card says where the project stands, and why. I build with AI agents under a review system I designed and <a href="/blog/agent-approval-workflow-genesis-of-mergepath/" class="p-link">documented here</a>. The agents are leverage; the product decisions are the point.</p>
      </header>

      {/* ── Project Grid ──
           Geometry follows the shared six-row Mondrian cycle from
           src/lib/index-grid.ts. Accent placement is boundary-aware so a
           later cycle never opens red immediately after a red closing row. */}
      <div class="blog-grid">

        {projects.map((project, i) => {
          const row = getIndexGridRow(i);
          const card = (
            <article class="post-card">
              {/* Status kicker renders on every card — consistency in the
                  card anatomy beats avoiding the apparent redundancy of
                  multiple cards saying SHIPPED. See #285. The previous
                  hide-when-LIVE rule from #277/#280 was reversed. */}
              <p class={statusClass(project.data.status)}>{project.data.status}</p>
              <p class="post-meta">{project.data.tags.join(' · ')}</p>
              <h2 class="post-title"><a href={`/projects/${project.data.slug}/`}>{project.data.title}</a></h2>
              <p class="post-desc">{project.data.cardDescription ?? project.data.description}</p>
              {project.data.liveUrl && (
                <div class="tag-row">
                  <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="tag">View &nearr;</a>
                </div>
              )}
            </article>
          );

          return (
            <div class={row.rowClass}>
              {card}
              {row.accentClasses.map((accentClass) => (
                <div class={accentClass} aria-hidden="true"></div>
              ))}
            </div>
          );
        })}

      </div>

      {/* ── Footer ── */}
      {/* AC7: a hiring reader who has finished the grid needs somewhere to go
          that is not the browser Back button. Same two destinations the
          homepage availability block offers, in the same order. */}
      <Footer
        attribution="Nathan Payne"
        variant="grid"
        links={[
          { href: "/resume/", label: "Résumé →" },
          { href: "https://cal.com/nathanpayne", label: "Book time →", external: true },
          { href: "/", label: "← Back to Homepage" },
        ]}
      />
    </div>
  </main>
</BaseLayout>
