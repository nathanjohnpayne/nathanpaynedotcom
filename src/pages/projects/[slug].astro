---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const seoDescription = data.seoDescription || data.description;

// SoftwareApplication node only when the project has a live URL.
// Pre-launch projects (no liveUrl) drop the SoftwareApplication entry
// rather than ship a SoftwareApplication with `url: undefined`, which
// search engines treat as malformed structured data.
const softwareApp = data.liveUrl
  ? [{
      "@type": "SoftwareApplication",
      "@id": `https://nathanpayne.com/projects/${data.slug}/#app`,
      "name": data.title,
      "applicationCategory": "WebApplication",
      "operatingSystem": "Web",
      "url": data.liveUrl,
      "creator": {
        "@type": "Person",
        "name": "Nathan Payne",
        "url": "https://nathanpayne.com/",
      },
      "description": seoDescription,
      "keywords": data.tags.join(', '),
      // A private-repo project has no public repository to point at, so the
      // key is omitted rather than emitting `sameAs: [undefined]` (#874).
      ...(data.githubUrl ? { "sameAs": [data.githubUrl] } : {}),
    }]
  : [];

const webPage: Record<string, unknown> = {
  "@type": "WebPage",
  "@id": `https://nathanpayne.com/projects/${data.slug}/#webpage`,
  "url": `https://nathanpayne.com/projects/${data.slug}/`,
  "name": `${data.title} | Nathan Payne`,
  "description": seoDescription,
  "keywords": data.tags.join(', '),
  "isPartOf": { "@id": "https://nathanpayne.com/#website" },
  "breadcrumb": { "@id": `https://nathanpayne.com/projects/${data.slug}/#breadcrumb` },
};
if (data.liveUrl) {
  webPage.mainEntity = { "@id": `https://nathanpayne.com/projects/${data.slug}/#app` };
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    webPage,
    {
      "@type": "BreadcrumbList",
      "@id": `https://nathanpayne.com/projects/${data.slug}/#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Nathan Payne", "item": "https://nathanpayne.com/" },
        { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://nathanpayne.com/projects/" },
        { "@type": "ListItem", "position": 3, "name": data.title, "item": `https://nathanpayne.com/projects/${data.slug}/` },
      ],
    },
    ...softwareApp,
  ],
};
---

<ProjectLayout
  title={`${data.title} | Nathan Payne`}
  description={seoDescription}
  ogImage={`https://nathanpayne.com/og/projects/${data.slug}.png`}
  kicker={data.kicker}
  headline={data.title}
  deck={data.description}
  breadcrumbLabel={data.title}
  accent={data.accent}
  screenshotAspect={data.screenshotAspect}
  screenshotSrc={data.screenshotSrc}
  screenshotSecondary={data.screenshotSecondary}
  muxPlaybackId={data.muxPlaybackId}
  slug={data.slug}
  liveUrl={data.liveUrl}
  githubUrl={data.githubUrl}
  status={data.status}
  metadata={data.metadata}
  stack={data.stack}
  related={data.related}
  jsonLd={jsonLd}
>
  {/*
    Forward the three case-study arrays as props rather than letting an
    .mdx body read `frontmatter.*`. In MDX, `frontmatter` is the RAW YAML —
    Zod has not run — so a field declared `.optional().default([])` reads
    as `undefined` when the key is absent from the file. `props.*` is the
    validated `data.*` with defaults applied. A page therefore authors
    `<DecisionLedger decisions={props.decisions} />`; a bare identifier is
    a ReferenceError. See plans/759/component-placement-decision.md.

    A JSX-style expression comment rather than an HTML one: `<!-- -->` in
    an Astro template is emitted to the output in general (BaseLayout
    ships several to every page), and an internal note about
    ReferenceErrors has no business reaching a reader.
  */}
  <Content
    decisions={data.decisions}
    constraints={data.constraints}
    learnings={data.learnings}
  />
</ProjectLayout>
