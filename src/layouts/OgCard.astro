---
/**
 * OgCard.astro — Shared OG image template layout
 *
 * Based on the 404 page's Mondrian grid. Renders a self-contained card
 * at 1200×630 viewport (2× DPR → 2400×1260 final PNG) for use as an
 * Open Graph image.
 *
 * Chromium screenshots this page during astro:build:done via Playwright.
 *
 * @see Issue #106 — Generate OG images at build time
 */
import '../styles/global.css';

interface Props {
  label: string;
  heading: string;
  description?: string;
  meta?: string;
}

const { label, heading, description, meta } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <style>
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url('/fonts/og/cormorant-garamond-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
        U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
        U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 300 700;
      font-display: swap;
      src: url('/fonts/og/inter-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
        U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
        U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>
</head>
<body class="og-body">
  <div class="og-shell">
    <div class="og-card">
      <div class="og-content">
        <div class="og-label">{label}</div>
        <h1 class="og-heading">{heading}</h1>
        {description && <p class="og-description">{description}</p>}
        {meta && <p class="og-meta">{meta}</p>}
      </div>

      {/* Decorative Mondrian accent blocks */}
      <div class="og-block og-red" aria-hidden="true"></div>
      <div class="og-block og-yellow-a" aria-hidden="true"></div>
      <div class="og-block og-blue" aria-hidden="true"></div>
      <div class="og-block og-black" aria-hidden="true"></div>
      <div class="og-block og-white-a" aria-hidden="true"></div>
      <div class="og-block og-white-b" aria-hidden="true"></div>
      <div class="og-block og-yellow-b" aria-hidden="true"></div>
      <div class="og-block og-white-c" aria-hidden="true"></div>
    </div>
  </div>
</body>
</html>
