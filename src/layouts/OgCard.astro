---
/**
 * OgCard.astro — Shared OG image template layout
 *
 * Based on the 404 page's Mondrian grid. Renders a self-contained card
 * at 1200×630 viewport (2× DPR → 2400×1260 final PNG) for use as an
 * Open Graph image.
 *
 * Chromium screenshots this page during astro:build:done via Playwright.
 *
 * Every card is full bleed (#1095, #1292): no stage, frame or shadow, a grid
 * that fills the image with color fields at every edge, and text inside the
 * safe zone that cropping and corner-rounding link previews keep. The rules
 * and their reasons live with the `.og-*` styles in global.css; the build
 * enforces the edge and safe-zone rules on each rendered card.
 *
 * `hero` is the homepage card: the name set large on one line, a one-line
 * tagline as the description, and the NP mark from the logo system in the
 * gray field under the red plane (#1110). Only the hero carries the mark. On
 * the interior cards it rendered below the size at which the logo system
 * drops the monogram and repeated the label (#1292). It is inlined from
 * public/images/brand/np-mark.svg so Playwright needs no network, and its
 * fills are swapped for the palette tokens (`src/lib/og-mark.ts`) so it
 * follows the card's 1930 register.
 *
 * @see Issue #106 — Generate OG images at build time
 */
import fs from 'node:fs';
import path from 'node:path';
import { tokenizeMarkFills } from '../lib/og-mark';
import '../styles/global.css';

interface Props {
  label: string;
  heading: string;
  description?: string;
  meta?: string;
  palette?: '1930';
  /** Homepage card: oversized one-line name, one-line tagline, and the NP mark. */
  hero?: boolean;
}

const { label, heading, description, meta, palette, hero } = Astro.props;
const headingClass = [
  'og-heading',
  !description ? 'og-heading--title-only' : '',
  description ? 'og-heading--with-description' : '',
  !description && heading.length > 52 ? 'og-heading--long' : '',
].filter(Boolean).join(' ');
const npMark = hero
  ? tokenizeMarkFills(
      fs.readFileSync(path.join(process.cwd(), 'public', 'images', 'brand', 'np-mark.svg'), 'utf-8')
    )
  : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <style>
    @font-face {
      font-family: 'Cormorant Garamond';
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url('/fonts/og/cormorant-garamond-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
        U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
        U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 300 700;
      font-display: swap;
      src: url('/fonts/og/inter-latin.woff2') format('woff2');
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
        U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122,
        U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  </style>
</head>
<body class="og-body" data-palette={palette}>
  <div class:list={['og-shell', { 'og-shell--hero': hero }]}>
    <div class="og-card">
      <div class="og-content">
        <div class="og-label">{label}</div>
        <h1 class={headingClass}>{heading}</h1>
        {description && <p class="og-description">{description}</p>}
        {meta && <p class="og-meta">{meta}</p>}
      </div>

      {/* Decorative Mondrian accent blocks */}
      <div class="og-block og-red" aria-hidden="true"></div>
      <div class="og-block og-gray" aria-hidden="true"></div>
      <div class="og-block og-yellow" aria-hidden="true"></div>
      <div class="og-block og-blue" aria-hidden="true"></div>
      <div class="og-block og-black" aria-hidden="true"></div>

      {npMark && <div class="og-mark" aria-hidden="true"><Fragment set:html={npMark} /></div>}
    </div>
  </div>
</body>
</html>
