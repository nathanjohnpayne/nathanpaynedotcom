---
/**
 * ProjectLayout — page layout for project detail pages (#470).
 *
 * Wraps BaseLayout and owns the project-page shell: it passes the
 * semantic accent to BaseLayout, lets CSS derive the palette from
 * `data-accent`, renders ProjectHero (variant derived from
 * `screenshotAspect`, so the hero modifier always matches the screenshot
 * treatment), then the `.metadata-surface` with MetadataStrip and the
 * screenshot figure (ProjectMuxPlayer: Mux video / GIF / static image
 * cascade), the prose slot, the related-links list, and the shared
 * Footer. The "Topics" metadata value is derived from the `kicker`
 * frontmatter (split on ×, joined with ·) — see the inline note below.
 *
 * Consumed by src/pages/projects/[slug].astro, which maps the `projects`
 * content-collection frontmatter onto these props.
 */
import BaseLayout from './BaseLayout.astro';
import ProjectHero from '../components/ProjectHero.astro';
import MetadataStrip from '../components/MetadataStrip.astro';
import ProjectMuxPlayer from '../components/ProjectMuxPlayer.astro';
import Footer from '../components/Footer.astro';

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  kicker: string;
  headline: string;
  deck: string;
  breadcrumbLabel: string;
  accent: 'red' | 'yellow' | 'black' | 'blue' | 'paper';
  screenshotAspect: 'wide' | 'narrow';
  screenshotSrc: string;
  screenshotSecondary?: { src: string; alt: string; width: number; height: number };
  muxPlaybackId?: string;
  slug: string;
  liveUrl?: string;
  githubUrl?: string;
  status: string;
  metadata: {
    format: string;
    focus: string;
  };
  stack?: string;
  related: RelatedLink[];
  jsonLd: object;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogDescription,
  kicker,
  headline,
  deck,
  breadcrumbLabel,
  accent,
  screenshotAspect,
  screenshotSrc,
  screenshotSecondary,
  muxPlaybackId,
  slug,
  liveUrl,
  githubUrl,
  status,
  metadata,
  stack,
  related,
  jsonLd,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
} = Astro.props;

// Derive the metadata-table "Topics" value from the same `kicker`
// frontmatter the hero used to render. Split on the multiplication
// sign (U+00D7) — the kicker's documented separator — and re-join
// with " · " to match the project-card metadata convention used
// elsewhere in the metadata table. Intentionally NOT splitting on
// lowercase `x`: that would silently slice mid-word on a future
// kicker like "AI × Mux × Streaming".
const topics = kicker.split(/\s*×\s*/).join(' · ');
---

<BaseLayout
  title={title}
  description={description}
  ogDescription={ogDescription}
  bodyClass="project-page"
  dataAccent={accent}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={ogImageAlt}
>
  <main class="page-shell">
    <article class="project-detail page-canvas">

      <ProjectHero
        variant={screenshotAspect}
        title={headline}
        deck={deck}
        breadcrumbLabel={breadcrumbLabel}
        liveUrl={liveUrl}
        githubUrl={githubUrl}
      />

      <div class="metadata-surface">
        <MetadataStrip
          topics={topics}
          format={metadata.format}
          focus={metadata.focus}
          status={status}
        />
        <figure
          class={`project-screenshot project-screenshot--${screenshotAspect}${
            screenshotSecondary ? ' project-screenshot--pair' : ''
          }`}
        >
          <div class="project-screenshot__inner">
            <ProjectMuxPlayer
              playbackId={muxPlaybackId}
              fallbackSrc={screenshotSrc}
              title={headline}
              slug={slug}
            />
            {screenshotSecondary && (
              <img
                src={screenshotSecondary.src}
                alt={screenshotSecondary.alt}
                width={screenshotSecondary.width}
                height={screenshotSecondary.height}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          {stack && (
            <figcaption class="project-stack">
              <span class="project-stack__label">Stack</span>
              <span class="project-stack__value">{stack}</span>
            </figcaption>
          )}
        </figure>
      </div>

      <div class="project-copy">
        <slot />
      </div>

      {related.length > 0 && (
        <section class="project-related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related</h2>
          <ul class="project-related__list">
            {related.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <Footer
        attribution="Nathan Payne"
        variant="detail"
        links={[
          { href: "/projects/", label: "← Back to Projects" },
          { href: "/", label: "Back to Homepage →" },
        ]}
      />

    </article>
  </main>

  <script is:inline define:vars={{ projectSlug: slug, projectTitle: headline, projectStatus: status }}>
    window.posthog?.capture('project_page_viewed', {
      project_slug: projectSlug,
      project_title: projectTitle,
      project_status: projectStatus
    });
  </script>
</BaseLayout>
