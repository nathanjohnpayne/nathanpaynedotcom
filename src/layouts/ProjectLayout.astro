---
import BaseLayout from './BaseLayout.astro';
import HeroWide from '../components/HeroWide.astro';
import HeroNarrow from '../components/HeroNarrow.astro';
import MetadataStrip from '../components/MetadataStrip.astro';
import ProjectMuxPlayer from '../components/ProjectMuxPlayer.astro';
import Footer from '../components/Footer.astro';

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  kicker: string;
  headline: string;
  deck: string;
  breadcrumbLabel: string;
  accentColorClass: string;
  accentColor: string;
  gradientFrom: string;
  gradientTo: string;
  screenshotAspect: 'wide' | 'narrow';
  screenshotSrc: string;
  muxPlaybackId?: string;
  slug: string;
  liveUrl?: string;
  githubUrl: string;
  status: string;
  metadata: {
    format: string;
    focus: string;
  };
  stack?: string;
  related: RelatedLink[];
  jsonLd: object;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogDescription,
  kicker,
  headline,
  deck,
  breadcrumbLabel,
  accentColorClass,
  accentColor,
  gradientFrom,
  gradientTo,
  screenshotAspect,
  screenshotSrc,
  muxPlaybackId,
  slug,
  liveUrl,
  githubUrl,
  status,
  metadata,
  stack,
  related,
  jsonLd,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
} = Astro.props;

// Derive the metadata-table "Topics" value from the same `kicker`
// frontmatter the hero used to render. Split on the multiplication
// sign (U+00D7) — the kicker's documented separator — and re-join
// with " · " to match the project-card metadata convention used
// elsewhere in the metadata table. Intentionally NOT splitting on
// lowercase `x`: that would silently slice mid-word on a future
// kicker like "AI × Mux × Streaming".
const topics = kicker.split(/\s*×\s*/).join(' · ');
---

<BaseLayout
  title={title}
  description={description}
  ogDescription={ogDescription}
  bodyClass={`project-page ${accentColorClass}`}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={ogImageAlt}
>
  <main
    class="project-shell"
    style={`--project-accent: ${accentColor}; --project-gradient-from: ${gradientFrom}; --project-gradient-to: ${gradientTo};`}
  >
    <article class="project-detail">

      {screenshotAspect === 'narrow' ? (
        <HeroNarrow
          title={headline}
          deck={deck}
          breadcrumbLabel={breadcrumbLabel}
          liveUrl={liveUrl}
          githubUrl={githubUrl}
        />
      ) : (
        <HeroWide
          title={headline}
          deck={deck}
          breadcrumbLabel={breadcrumbLabel}
          liveUrl={liveUrl}
          githubUrl={githubUrl}
        />
      )}

      <div class="metadata-surface">
        <MetadataStrip
          topics={topics}
          format={metadata.format}
          focus={metadata.focus}
          status={status}
        />
        <figure class={`project-screenshot project-screenshot--${screenshotAspect}`}>
          <div class="project-screenshot__inner">
            <ProjectMuxPlayer
              playbackId={muxPlaybackId}
              fallbackSrc={screenshotSrc}
              title={headline}
              slug={slug}
            />
          </div>
          {stack && (
            <figcaption class="project-stack">
              <span class="project-stack__label">Stack</span>
              <span class="project-stack__value">{stack}</span>
            </figcaption>
          )}
        </figure>
      </div>

      <div class="project-copy">
        <slot />
      </div>

      {related.length > 0 && (
        <section class="project-related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related</h2>
          <ul class="project-related__list">
            {related.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <Footer
        attribution="Nathan Payne"
        variant="detail"
        links={[
          { href: "/projects/", label: "← Back to Projects" },
          { href: "/", label: "Back to Homepage →" },
        ]}
      />

    </article>
  </main>
</BaseLayout>
