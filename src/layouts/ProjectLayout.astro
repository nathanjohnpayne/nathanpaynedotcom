---
import BaseLayout from './BaseLayout.astro';
import HeroWide from '../components/HeroWide.astro';
import HeroNarrow from '../components/HeroNarrow.astro';
import MetadataStrip from '../components/MetadataStrip.astro';

interface RelatedLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  kicker: string;
  headline: string;
  deck: string;
  breadcrumbLabel: string;
  accentColorClass: string;
  accentColor: string;
  gradientFrom: string;
  gradientTo: string;
  screenshotAspect: 'wide' | 'narrow';
  screenshotSrc: string;
  liveUrl: string;
  githubUrl: string;
  metadata: {
    domain: string;
    format: string;
    focus: string;
    status: string;
  };
  stack?: string;
  related: RelatedLink[];
  jsonLd: object;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogDescription,
  kicker,
  headline,
  deck,
  breadcrumbLabel,
  accentColorClass,
  accentColor,
  gradientFrom,
  gradientTo,
  screenshotAspect,
  screenshotSrc,
  liveUrl,
  githubUrl,
  metadata,
  stack,
  related,
  jsonLd,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogDescription={ogDescription}
  bodyClass={`project-page ${accentColorClass}`}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={ogImageAlt}
>
  <main
    class="project-shell"
    style={`--project-accent: ${accentColor}; --project-gradient-from: ${gradientFrom}; --project-gradient-to: ${gradientTo};`}
  >
    <article class="project-detail">

      {screenshotAspect === 'narrow' ? (
        <HeroNarrow
          title={headline}
          kicker={kicker}
          deck={deck}
          breadcrumbLabel={breadcrumbLabel}
          liveUrl={liveUrl}
          githubUrl={githubUrl}
        />
      ) : (
        <HeroWide
          title={headline}
          kicker={kicker}
          deck={deck}
          breadcrumbLabel={breadcrumbLabel}
          liveUrl={liveUrl}
          githubUrl={githubUrl}
        />
      )}

      <div class="metadata-surface">
        <MetadataStrip
          domain={metadata.domain}
          format={metadata.format}
          focus={metadata.focus}
          status={metadata.status}
        />
        <figure class={`project-screenshot project-screenshot--${screenshotAspect}`}>
          <div class="project-screenshot__inner">
            <img src={screenshotSrc} alt={`${headline} product screenshot`} loading="eager" />
            {stack && (
              <figcaption class="project-stack">
                <span class="project-stack__label">Stack</span>
                <span class="project-stack__value">{stack}</span>
              </figcaption>
            )}
          </div>
        </figure>
      </div>

      <div class="project-copy">
        <slot />
      </div>

      {related.length > 0 && (
        <section class="project-related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related</h2>
          <ul class="project-related__list">
            {related.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </section>
      )}

      <footer class="project-detail-footer">
        <p class="project-footer-attribution">Nathan Payne &middot; San Francisco</p>
        <nav class="project-footer-nav" aria-label="Project footer navigation">
          <a class="project-action" href="/projects/">&larr; Back to Projects</a>
          <a class="project-action" href="/">Back to Homepage &rarr;</a>
        </nav>
      </footer>

    </article>
  </main>
</BaseLayout>
