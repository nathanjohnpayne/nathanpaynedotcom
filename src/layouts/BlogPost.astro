---
/**
 * BlogPost.astro — Mondrian "Composition with Margins" layout
 *
 * Renders a blog post inside a 3-column Mondrian CSS Grid:
 *   - Left margin:  narrow accent blocks (red, yellow, blue) — pure decoration
 *   - Center:       main content column (<slot /> — unchanged Markdown flow)
 *   - Right sidebar: sticky ToC, pullquotes, sidebar items (mermaid, images)
 *
 * At ≤1023px (--bp-stack, see #313) the grid collapses to a single column:
 *   - Margin and sidebar hidden
 *   - Content fills full width inside a var(--line) frame
 *   - Matches homepage responsive collapse behavior
 *
 * Sidebar content is driven by frontmatter:
 *   - ToC: extracted from Astro's built-in render() headings (no plugin needed)
 *   - Pullquotes: frontmatter `pullquotes` array with text, label, accent color
 *   - Sidebar items: frontmatter `sidebar` array (mermaid diagrams, images)
 *
 * @see Issue #74 — Blog post template: Mondrian composition with margins layout
 */
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { renderSidebarMermaid } from '../lib/render-sidebar-mermaid.mjs';

interface PostLink {
  title: string;
  href: string;
  readingTime: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  shortTitle?: string;
  description: string;
  seoDescription?: string;
  author: string;
  date: Date;
  tags: string[];
  image: string;
  readingTime: string;
  headings: { depth: number; slug: string; text: string }[];
  keyTakeaways?: string[];
  pullquotes: { text: string; label?: string; accent: string }[];
  sidebar: (
    | { type: 'mermaid'; content: string; title: string; description: string; caption?: string }
    | { type: 'image' | 'text'; content: string; caption?: string }
  )[];
  /** Older neighbour by date; null on the oldest post (no wrap). */
  prevPost?: PostLink | null;
  /** Newer neighbour by date; null on the newest post (no wrap). */
  nextPost?: PostLink | null;
}

const {
  title,
  seoTitle,
  shortTitle,
  description,
  seoDescription,
  author,
  date,
  tags,
  image,
  readingTime,
  headings,
  keyTakeaways = [],
  pullquotes,
  sidebar,
  prevPost = null,
  nextPost = null,
} = Astro.props;

const rawPathname = Astro.url.pathname;
const normalizedPathname = rawPathname === '/' || rawPathname.includes('.')
  ? rawPathname
  : rawPathname.endsWith('/')
    ? rawPathname
    : `${rawPathname}/`;
const canonical = new URL(normalizedPathname, Astro.site).href;
// One canonical headline per post (#623). `title` is the headline of record —
// it renders as the <h1>, the /blog card, the homepage link, RSS and the
// JSON-LD headline. `seoTitle` is the same headline trimmed to the ~60-char
// SERP budget once the " | Nathan Payne" suffix is added; it must stay
// recognisably the same headline (enforced by tests/blog-title-consistency).
// `shortTitle` is deliberately NOT in this chain: it is a breadcrumb-width
// abbreviation, and letting it stand in for the page title is what made a
// shared link unfurl with a headline the reader never saw on the page.
const pageTitle = `${seoTitle || title} | Nathan Payne`;
const seoSummary = seoDescription || description;
const publishedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = date.toISOString();

// Derive OG image path from URL slug (e.g., /blog/my-post/ → /og/blog/my-post.png)
const slug = normalizedPathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const ogImagePath = `https://nathanpayne.com/og/blog/${slug}.png`;

// Filter headings for ToC — only h2-level entries
const tocHeadings = headings.filter((h) => h.depth === 2);

// Determine if sidebar has any content to render
const hasSidebar = tocHeadings.length > 0 || pullquotes.length > 0 || sidebar.length > 0;
const renderedSidebarMermaid = await renderSidebarMermaid(sidebar, Astro.url.pathname);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": pageTitle,
      "description": seoSummary,
      "isPartOf": { "@id": "https://nathanpayne.com/#website" },
      "breadcrumb": { "@id": `${canonical}#breadcrumb` },
      "primaryImageOfPage": { "@id": `${canonical}#primaryimage` },
      "mainEntity": { "@id": `${canonical}#article` },
    },
    {
      "@type": "ImageObject",
      "@id": `${canonical}#primaryimage`,
      "url": `https://nathanpayne.com${image}`,
      "width": 2400,
      "height": 1260,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Nathan Payne", "item": "https://nathanpayne.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://nathanpayne.com/blog/" },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonical },
      ],
    },
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#article`,
      "headline": title,
      "description": seoSummary,
      "image": `https://nathanpayne.com${image}`,
      "url": canonical,
      "datePublished": isoDate,
      "dateModified": isoDate,
      "inLanguage": "en-US",
      "isAccessibleForFree": true,
      "author": { "@type": "Person", "name": author, "url": "https://nathanpayne.com/" },
      "publisher": { "@type": "Person", "name": author, "url": "https://nathanpayne.com/" },
      "mainEntityOfPage": { "@id": `${canonical}#webpage` },
      "keywords": tags.join(', '),
      // The takeaways are the post's thesis in the author's own words, which
      // is exactly what schema.org's `abstract` is for (#621). Omitted rather
      // than emitted empty when a post carries no takeaways.
      ...(keyTakeaways.length > 0 ? { "abstract": keyTakeaways.join(' ') } : {}),
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={seoSummary}
  canonical={canonical}
  ogType="article"
  ogImage={ogImagePath}
  ogImageAlt={`${title} open graph image`}
  bodyClass="project-page blog-page"
  dataAccent="red"
  jsonLd={jsonLd}
  articleMeta={{ published: isoDate, author, tags }}
>
  <main class="page-shell">
    {/* ── Mondrian Canvas Grid ──────────────────────────────────
         3-column composition: accent margin | content | sidebar
         Grid lines are the --ink background showing through gaps.
         ──────────────────────────────────────────────────────── */}
    <article class="blog-canvas page-canvas">

      {/* ── Left margin: per-row Mondrian accent blocks ── */}
      <div class="blog-margin blog-margin--header" aria-hidden="true"></div>
      <div class="blog-margin blog-margin--body" aria-hidden="true"></div>
      <div class="blog-margin blog-margin--footer" aria-hidden="true"></div>

      {/* ── Header ── */}
      {/* No --inset variants here (#455 finding 8): the inset exists to clear
          the project hero's accent bar, which this header doesn't have — the
          h1 is flush left, so breadcrumb and deck must be too. */}
      <header class="blog-canvas-header">
        <Breadcrumbs
          items={[
            { label: "Nathan Payne", href: "/" },
            { label: "Blog", href: "/blog/" },
            { label: shortTitle || 'Article' },
          ]}
        />
        <h1>{title}</h1>
        <p class="deck">{description}</p>
      </header>

      {/* ── Sidebar: metadata panel ── */}
      <div class="blog-sidebar-meta">
        <dl>
          <div><dt>Published</dt><dd>{publishedDate}</dd></div>
          <div><dt>Author</dt><dd>{author}</dd></div>
          <div><dt>Reading time</dt><dd>{readingTime}</dd></div>
          <div>
            <dt>Topics</dt>
            <dd class="blog-sidebar-topics">
              {tags.map((tag) => (
                <span class="blog-sidebar-topic">{tag}</span>
              ))}
            </dd>
          </div>
        </dl>
      </div>

      {/* ── Main content column ── */}
      <div class="blog-content">

        {/* Key takeaways (#621) — article column, not the sidebar: the
            sidebar already carries ToC + pullquotes + diagrams and is
            hidden below --bp-stack, and this is the one block that has to
            reach the skimmer and the crawler. Real heading + real list so
            it reads as content, not chrome. */}
        {/* The heading id is namespaced rather than the natural
            "key-takeaways" slug: Astro slugs markdown headings from their
            visible text, so a post that ever writes "## Key takeaways" in its
            body would emit a second id="key-takeaways" and break this
            aria-labelledby reference. No heading text slugs to
            "blog-takeaways-heading". */}
        {keyTakeaways.length > 0 && (
          <section class="blog-takeaways" aria-labelledby="blog-takeaways-heading">
            <h2 class="blog-takeaways__heading" id="blog-takeaways-heading">Key takeaways</h2>
            <ul class="blog-takeaways__list" role="list">
              {keyTakeaways.map((takeaway) => (
                <li>{takeaway}</li>
              ))}
            </ul>
          </section>
        )}

        <article class="blog-prose">
          <slot />
        </article>

        {/* ── End-of-post block (#622) ──────────────────────────────
             Prev/next by date + the author footer. Sits after
             a rule so it reads as a separate beat from the post's closing
             line, and is hidden in @media print. ───────────────────── */}
        <div class="blog-postscript">
          {(prevPost || nextPost) && (
            <nav class="blog-postnav" aria-label="More posts">
              {prevPost && (
                <a
                  class="blog-postnav__card blog-postnav__card--prev"
                  href={prevPost.href}
                  data-postnav="previous"
                >
                  <span class="blog-postnav__label">&larr; Previous</span>
                  <span class="blog-postnav__title">{prevPost.title}</span>
                  <span class="blog-postnav__meta">{prevPost.readingTime}</span>
                </a>
              )}
              {nextPost && (
                <a
                  class="blog-postnav__card blog-postnav__card--next"
                  href={nextPost.href}
                  data-postnav="next"
                >
                  <span class="blog-postnav__label">Next &rarr;</span>
                  <span class="blog-postnav__title">{nextPost.title}</span>
                  <span class="blog-postnav__meta">{nextPost.readingTime}</span>
                </a>
              )}
            </nav>
          )}

          {/* Author footer. One sentence, three links, no pitch—an
              unsubtle CTA undercuts the credibility the post just built.
              The line wraps: `.blog-cta__line` is `flex-wrap: wrap`, so the
              byline takes a row and the links the next at desktop width, and
              more of both on a phone. It read as one row while the lede was
              five words.
              The lede was an availability statement until #969: "Open to
              senior product/platform roles." directly after an essay
              reframes the author from someone with something to say into
              someone looking for work. The links are unchanged; the
              sentence above them is now a byline, and the aria-label names
              the block for what it is. The class namespace stays
              `blog-cta`—`blog_cta_clicked` and `.blog-cta__link` are the
              analytics contract (specs/analytics.md).
              The byline names Nathan rather than reading `author` off the
              post, and the three links are his. That is correct only while
              every post is his, so the assumption is asserted rather than
              assumed—see the author invariant in
              tests/blog-takeaways-cta.test.js. Templating just the name
              would be worse than not templating it: a guest would get their
              own name over someone else's bio and contact links. A real
              guest post needs the block designed, not interpolated.
              The mailto is assembled client-side from base64 fragments so
              the address never appears in the static HTML, matching the
              homepage contact line; <noscript> carries the fallback. */}
          <aside class="blog-cta" aria-label="About the author">
            <p class="blog-cta__line">
              <span class="blog-cta__lede">Nathan Payne is a product manager writing about AI, software, and product development.</span>
              <a class="blog-cta__link" href="/resume/" data-cta="resume"
                >Résumé<span class="link-arrow" aria-hidden="true">→</span></a
              >
              <span class="blog-cta__sep" aria-hidden="true">·</span>
              <a
                id="blog-cta-mailto"
                class="blog-cta__link"
                href="#"
                data-cta="email"
                data-u="aGlyZQ=="
                data-d="bmF0aGFucGF5bmUuY29t"
                data-s="RnJvbSUyMHRoZSUyMGJsb2c="
                >Get in touch<span class="link-arrow" aria-hidden="true">→</span></a
              >
              <span class="blog-cta__sep" aria-hidden="true">·</span>
              <a
                class="blog-cta__link"
                href="https://cal.com/nathanpayne"
                rel="noopener"
                target="_blank"
                data-cta="schedule"
                >Book a time<span class="link-arrow" aria-hidden="true">→</span></a
              >
            </p>
            <noscript>
              <p class="blog-cta__noscript">Email: hire [at] nathanpayne [dot] com</p>
            </noscript>
          </aside>
        </div>
      </div>

      {/* ── Right sidebar ──────────────────────────────────────
           The <aside> stretches the full grid cell height so its
           white background covers the entire row. The inner div
           handles sticky scrolling independently.
           ──────────────────────────────────────────────────── */}
      {hasSidebar && (
        <aside class="blog-sidebar" aria-label="Article sidebar">
          <div class="blog-sidebar-inner">

            {/* Table of Contents — extracted from Astro's built-in headings */}
            {tocHeadings.length > 0 && (
              <nav class="blog-sidebar-section blog-sidebar-toc" aria-label="Table of contents">
                <h2 class="blog-sidebar-heading">In this article</h2>
                <ol class="blog-sidebar-toc-list">
                  {tocHeadings.map((h) => (
                    <li><a href={`#${h.slug}`}>{h.text}</a></li>
                  ))}
                </ol>
              </nav>
            )}

            {/* Pullquotes — bordered cards with accent left border */}
            {pullquotes.map((pq) => (
              <blockquote class={`blog-sidebar-pullquote blog-sidebar-pullquote--${pq.accent}`}>
                <p>&ldquo;{pq.text}&rdquo;</p>
                {pq.label && <cite>{pq.label}</cite>}
              </blockquote>
            ))}

            {/* Sidebar items — mermaid diagrams, images from frontmatter */}
            {sidebar.map((item, index) => (
              <div class="blog-sidebar-item">
                {item.type === 'mermaid' && (
                  <Fragment set:html={renderedSidebarMermaid.get(index)} />
                )}
                {item.type === 'image' && (
                  <img src={item.content} alt={item.caption || 'Sidebar illustration'} loading="lazy" />
                )}
                {item.type === 'text' && (
                  <p class="blog-sidebar-text">{item.content}</p>
                )}
                {item.caption && (
                  <p class="blog-sidebar-caption">{item.caption}</p>
                )}
              </div>
            ))}

          </div>
        </aside>
      )}

      {/* ── Footer ── */}
      <Footer
        attribution={author}
        variant="canvas"
        links={[
          { href: "/blog/", label: "← Back to Blog" },
          { href: "/", label: "Back to Homepage →" },
        ]}
      />
    </article>
  </main>

  <script is:inline define:vars={{ postTitle: title, postTags: tags, postReadingTime: readingTime }}>
    window.posthog?.capture('blog_post_viewed', {
      post_title: postTitle,
      tags: postTags,
      reading_time: postReadingTime
    });

    // End-of-post block (#622). The mailto href is assembled here so the
    // address never ships in the static HTML (same pattern as the homepage
    // `.availability-signal` line); the <noscript> line covers JS-disabled
    // readers.
    (function () {
      const mailto = document.getElementById('blog-cta-mailto');
      if (mailto) {
        try {
          const user = atob(mailto.dataset.u);
          const domain = atob(mailto.dataset.d);
          const subject = mailto.dataset.s ? atob(mailto.dataset.s) : '';
          mailto.href = 'mailto:' + user + '@' + domain + (subject ? '?subject=' + subject : '');
        } catch (_e) { /* leave href as "#" — noscript covers the fallback */ }
      }

      // Distinct events: the CTA measures hiring intent, prev/next measures
      // whether the end-of-post block keeps readers on the blog.
      document.querySelectorAll('.blog-cta__link').forEach(function (link) {
        link.addEventListener('click', function () {
          window.posthog?.capture('blog_cta_clicked', {
            cta: link.dataset.cta,
            post_title: postTitle
          });
        });
      });

      document.querySelectorAll('.blog-postnav__card').forEach(function (card) {
        card.addEventListener('click', function () {
          window.posthog?.capture('blog_post_nav_clicked', {
            direction: card.dataset.postnav,
            from_post_title: postTitle,
            to_post_href: card.getAttribute('href')
          });
        });
      });
    })();
  </script>
</BaseLayout>
