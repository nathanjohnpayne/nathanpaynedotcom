.DS_Store
# No trailing slash: worktrees symlink node_modules to the main checkout's, and
# `node_modules/` matches only directories, so a symlink showed as untracked.
node_modules
.firebase/
.env
.env.*
!.env.example
!*.tpl
*.pem
*.key
service-account.json
firebase-adminsdk*.json
RIPCUT_GUIDE.md

# Astro build output
dist/
# #1079 flag-on test build (npm run build:privacy-test) and the flag-off
# comparison build (scripts/build-flag-off.mjs, run by npm test)
dist-privacy-test/
dist-flag-off/
.astro/

# Playwright
test-results/
playwright-report/

# Claude Code local settings
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
screenshots/*
!screenshots/og/
!screenshots/og/**
!screenshots/privacy/
!screenshots/privacy/**

# Logs
*.log
logs/

# Editor
.vscode/
!.vscode/extensions.json
.idea/

# Cursor runtime artifacts
.cursor/cache/
.cursor/state/
.cursor/plans/

# Coverage
coverage/

# Misc
tmp/
.cache/
.env.local

# Phase 4b orchestrator accounting logs (scripts/phase-4b-review.sh).
# Local session artifacts, not repository content. mergepath gitignores
# `.mergepath/` upstream; this consumer repo did not carry that entry, so the
# first automated Phase 4b run wrote its loop log into a PR commit (#635).
.mergepath/
