{
  "name": "nathanpaynedotcom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/refresh-hero-images.mjs && node scripts/refresh-mux-gifs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro build && vitest run",
    "test:e2e": "playwright test",
    "deploy": "scripts/check-deploy-env.sh && npm run build && op-firebase-deploy && scripts/cf-cache-purge.sh",
    "deploy:hosting": "scripts/check-deploy-env.sh && npm run build && op-firebase-deploy --only hosting && scripts/cf-cache-purge.sh",
    "lint": "scripts/lint-all.sh",
    "lint:js": "eslint .",
    "lint:content-em-dash": "node scripts/lint-content-em-dash.mjs",
    "typecheck": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\""
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "astro": "7.2.2",
    "decode-named-character-reference": "^1.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "js-yaml": "^5.3.0",
    "jsdom": "^30.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prettier": "^3.9.6",
    "typescript": ">=6.0.3 <6.1.0",
    "typescript-eslint": "^8.67.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@mux/mux-background-video": "^0.2.3"
  }
}
