{
  "name": "nathanpaynedotcom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/refresh-hero-images.mjs && node scripts/refresh-mux-gifs.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "astro build && vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && op-firebase-deploy && scripts/cf-cache-purge.sh",
    "lint": "eslint .",
    "typecheck": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "astro": "^7.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^2.0.0",
    "globals": "^17.7.0",
    "js-yaml": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@mux/mux-background-video": "^0.2.3"
  }
}
