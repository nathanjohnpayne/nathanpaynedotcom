{
  "name": "nathanpaynedotcom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/refresh-hero-images.mjs && node scripts/refresh-mux-gifs.mjs",
    "og:refresh": "node scripts/refresh-og-references.mjs",
    "build": "astro build",
    "build:privacy-test": "PUBLIC_POSTHOG_PROJECT_TOKEN=phc_privacy_test_fake PUBLIC_GA_MEASUREMENT_ID=G-PRIVACYTEST PUBLIC_LOGODEV_KEY= astro build --mode privacy-test --outDir dist-privacy-test",
    "preview": "astro preview",
    "test": "node scripts/build-production-check.mjs && astro build && NP_PRODUCTION_CHECK_DIST=dist-production-check vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "scripts/lint-all.sh",
    "lint:js": "eslint .",
    "lint:prose": "node scripts/lint-prose.mjs",
    "typecheck": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,css}\" \"tests/**/*.{ts,js}\""
  },
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "acorn": "8.19.0",
    "astro": "7.4.2",
    "css-tree": "^3.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "hast-util-to-html": "^9.0.5",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rehype-mermaid": "^3.0.0",
    "typescript": ">=6.0.3 <6.1.0",
    "typescript-eslint": "^8.72.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@mux/mux-background-video": "^0.2.3",
    "mux-embed": "^5.18.2"
  }
}
