# Client-side PUBLIC_* env vars baked into the static build by Astro
# (import.meta.env). Resolved from .env.local, which scripts/bootstrap.sh
# generates from .env.tpl via `op inject`. Copy this file to .env.local
# and fill in real values for local development.

# Logo.dev publishable token. Drives the employer/school/issuer logos on
# /resume (CompanyLogo.astro). Read-only client identifier, safe to ship
# in the static HTML — but sourced from env, never hardcoded. Optional:
# if unset, /resume renders styled initials instead of remote logos.
PUBLIC_LOGODEV_KEY=pk_your_publishable_token_here

# PostHog public project ingest token. Optional: if unset, PostHog
# analytics and session replay do not initialize.
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_public_project_token_here

# Google Analytics 4 Measurement ID. Optional: if unset, GA tags are not
# rendered and section_view events are skipped.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
