# Copy to .env.local and fill in. Never commit real values.

# LiveKit Cloud project (lk app env --write --destination .env.local fills these)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cal.com API v2: an API key for the calendar owner, and the numeric ID of the
# event type for phone calls that the agent books.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Nathan's time zone (IANA name). Defaults to America/Los_Angeles.
OWNER_TIMEZONE=

# Local development only: an E.164 number to book with when the session has no
# SIP caller (lk agent console, or the browser Agent Console). Leave empty in
# every deployed environment; real calls use the SIP caller ID only.
DEV_CALLER_PHONE=

# Anonymous call analytics (#1573). The website's PostHog project token (it is
# public; the site ships it to every browser). Leave empty to send nothing.
POSTHOG_PROJECT_TOKEN=
# Optional; defaults to https://us.i.posthog.com.
POSTHOG_HOST=
# The owner's own number, E.164. Calls from it are flagged as test calls in
# analytics; the number itself is never sent.
OWNER_PHONE=
